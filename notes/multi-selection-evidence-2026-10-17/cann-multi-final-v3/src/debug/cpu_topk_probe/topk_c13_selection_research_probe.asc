#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"
#include "c13_group4_research_kernel.h"
#include "c13_block8_prefix_research_kernel.h"

namespace {

__global__ __vector__ void c13_selection_launch(GM_ADDR input, GM_ADDR output,
                                                     int32_t rows, int32_t experts, int32_t cores)
{
    AscendC::InitSocState();
#ifdef C13_BASELINE
    SqrtSoftplusVendorPerfTopKKernel kernel;
    kernel.Init(input, output, rows, experts, (experts+31)/32*32, 8, cores);
    kernel.Process();
#else
#ifdef C13_BLOCK8
    C13Block8PrefixResearchKernel kernel;
#else
    C13Group4ResearchKernel kernel;
#endif
    kernel.Init(input, output, rows, experts, cores);
    kernel.Process();
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 4093 - 2046;
        input[base + static_cast<size_t>(i)] =
            static_cast<float>(raw) / 64.0f +
            static_cast<float>(i % 29) * 0.0009765625f +
            static_cast<float>(row % 17) * 0.0078125f;
    }
    input[base] = 40.0f + static_cast<float>(row % 8);
    if (experts > 1) {
        input[base + 1] = -INFINITY;
    }
    if (experts > 2) {
        input[base + 2] = 23.5f + static_cast<float>(row % 8);
    }
    if (k == 64 && row % 8 == 0) {
        std::fill(input.begin() + base, input.begin() + base + experts, -20.0f);
        const int start = ((row / 8) % (experts / 128)) * 128;
        for (int i = 0; i < 64; ++i) { input[base + start + i] = 80.0f - i; }
    } else if (k == 64 && row % 8 == 1) {
        std::fill(input.begin() + base, input.begin() + base + experts, -4.0f);
    } else if (k == 64 && row % 8 == 2) {
        for (int i = 0; i < 64; ++i) { input[base + experts - 1 - i] = 100.0f - i; }
    } else if (row % 8 == 4) {
        std::fill(input.begin() + base, input.begin() + base + experts, -INFINITY);
    } else if (row % 8 == 5) {
        std::fill(input.begin() + base, input.begin() + base + experts, -10000.0f);
    } else if (row % 8 == 6) {
        for (int i = 0; i < experts; ++i) {
            input[base + i] = i % 3 == 0 ? 10000.0f : -10000.0f;
        }
    } else if (row % 8 == 7) {
        for (int i = 0; i < experts; ++i) { input[base + i] = static_cast<float>(i % 5); }
    }
    if (k == 8) {
        const int kind = row % 16;
        if (kind == 0 || kind == 8 || kind == 9) {
            std::fill(input.begin()+base,input.begin()+base+experts,-20.0f);
            const int width = kind == 9 ? 32 : 8;
            const int start = ((row/16) % (experts/width))*width;
            for(int i=0;i<8;++i) input[base+start+i]=40.0f-i;
        } else if (kind == 1) {
            std::fill(input.begin()+base,input.begin()+base+experts,-4.0f);
        } else if (kind == 2) {
            for(int i=0;i<8;++i) input[base+experts-1-i]=50.0f-i;
        } else if (kind == 3) {
            std::fill(input.begin()+base,input.begin()+base+experts,-INFINITY);
            input[base]=30.0f; // Invalid padded IDs must never duplicate this winner.
        } else if (kind == 12 || kind == 13) {
            std::fill(input.begin()+base,input.begin()+base+experts,-20.0f);
            // Four winners in each of only two strided groups, or all eight in a 64-column region.
            for(int i=0;i<8;++i) {
                const int col = kind == 12 ? (i%4)*64+i/4 : 64+(i%8);
                input[base+col]=60.0f-i;
            }
        } else if (kind == 10) {
            for(int i=0;i<experts;++i) input[base+i]=1.0f+i*0.00000011920928955078125f;
        }
#ifdef C13_RAW
        if (kind == 11) {
            for(int i=0;i<experts;++i) input[base+i]=i%3==0?3.402823466e38f:-3.402823466e38f;
        }
#endif
    }

}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    const int32_t inner = (experts + 31) / 32 * 32;
    const bool supported =
        experts == 210 && k == 8;
    if (!supported) {
        std::fprintf(
            stderr,
            "unsupported fp32 large probe shape rows=%d E=%d inner=%d k=%d\n",
            rows,
            experts,
            inner,
            k);
        return false;
    }

    std::vector<float> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(float);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    const int32_t blockNum = rows < availableCoreNum ? rows : availableCoreNum;
    std::printf(
        "RUN fp32-large rows=%d E=%d inner=%d k=%d cores=%d\n",
        rows,
        experts,
        inner,
        k,
        blockNum);
    std::fflush(stdout);

    if (ok) {
        c13_selection_launch<<<blockNum, nullptr, stream>>>(
            (GM_ADDR)inputDevice, (GM_ADDR)outputDevice, rows, experts, blockNum);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    input[inputBase + static_cast<size_t>(i)];
            }
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
#ifdef C13_RAW
                const float exact = sorted[static_cast<size_t>(i)];
#else
                const float exact = ReferenceTransform(sorted[static_cast<size_t>(i)]);
#endif
                const float actual =
                    output[outputBase + static_cast<size_t>(i)];
                const float tolerance =
                    2.0e-5f * std::fmax(1.0f, std::fabs(exact));
#ifdef C13_RAW
                if (actual != exact) {
#else
                if (!(std::isnan(exact) ? std::isnan(actual)
                      : std::fabs(actual - exact) <= tolerance)) {
#endif
                    std::fprintf(
                        stderr,
                        "[MISMATCH] rows=%d E=%d k=%d row=%d i=%d actual=%.9g exact=%.9g rawTop=%.9g\n",
                        rows,
                        experts,
                        k,
                        row,
                        i,
                        actual,
                        exact,
                        sorted[static_cast<size_t>(i)]);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    if (platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1") == nullptr) {
        std::fprintf(stderr, "platform initialization failed\n");
        ok = false;
    }

    struct TestCase {
        int32_t rows;
        int32_t experts;
        int32_t k;
        int32_t cores;
    };
    std::vector<TestCase> cases;
    for(int experts : {210}) {
        for(int rows : {1,3,7,8,9,15,16,17,31,32,33,63,64,65,128,129})
            cases.push_back({rows,experts,8,1});
        for(int rows : {17,129,257}) cases.push_back({rows,experts,8,8});
    }
    if (argc == 5) {
        cases = {{std::atoi(argv[1]), std::atoi(argv[2]), std::atoi(argv[3]), std::atoi(argv[4])}};
        if (cases[0].rows < 1 || cases[0].cores < 1 || cases[0].cores > 48) { ok = false; }
    } else if (argc != 1) { ok = false; }
    int32_t passed = 0;
    if (ok) {
        for (const auto& test : cases) {
            ok = RunOne(stream, test.rows, test.experts, test.k, test.cores);
            if (!ok) {
                break;
            }
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d C13 selection research cases\n", passed);
    }
    return ok ? 0 : 1;
}
