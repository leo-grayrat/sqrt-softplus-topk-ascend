#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace {

constexpr int32_t CHUNK = 32;
constexpr int32_t MAX_EXPERTS = 1024;
constexpr int32_t MAX_CHUNKS = MAX_EXPERTS / CHUNK;
constexpr int32_t MAX_K = 8;
constexpr uint32_t MAX_SCORE_BYTES = MAX_EXPERTS * sizeof(float);
constexpr uint32_t MAX_INDEX_BYTES = MAX_EXPERTS * sizeof(int32_t);
constexpr uint32_t MAX_SORTED_BYTES = MAX_EXPERTS * 2 * sizeof(float);
constexpr int32_t MERGE_STRIDE_FLOATS = 64;
constexpr int32_t MAX_FIRST_LEVEL_QUEUES = (MAX_CHUNKS + 3) / 4;
constexpr uint32_t MERGE_BUFFER_BYTES =
    MAX_FIRST_LEVEL_QUEUES * MERGE_STRIDE_FLOATS * sizeof(float);
constexpr uint32_t MAX_OUTPUT_BYTES = MAX_K * 2 * sizeof(float);

class PrefixMergePaddingProbeKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR scores,
        GM_ADDR outputPairs,
        int32_t experts,
        int32_t k)
    {
        experts_ = experts;
        inner_ = (experts_ + CHUNK - 1) / CHUNK * CHUNK;
        chunkCount_ = inner_ / CHUNK;
        k_ = k;

        scoresGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outputPairs));

        pipe_.InitBuffer(scoreQueue_, 1, MAX_SCORE_BYTES);
        pipe_.InitBuffer(indexBuffer_, MAX_INDEX_BYTES);
        pipe_.InitBuffer(sortedBuffer_, MAX_SORTED_BYTES);
        pipe_.InitBuffer(mergeABuffer_, MERGE_BUFFER_BYTES);
        pipe_.InitBuffer(mergeBBuffer_, MERGE_BUFFER_BYTES);
        pipe_.InitBuffer(outputQueue_, 1, MAX_OUTPUT_BYTES);
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        SortAndMerge();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<float> scoreLocal = scoreQueue_.AllocTensor<float>();
        const uint32_t rawBytes = static_cast<uint32_t>(experts_) * sizeof(float);
        const uint32_t alignedBytes = (rawBytes + 31u) / 32u * 32u;
        const uint32_t alignedElems = alignedBytes / sizeof(float);
        const uint8_t rightPadding = static_cast<uint8_t>(alignedElems - experts_);
        const float negativeInf = -INFINITY;

        AscendC::DataCopyExtParams copyParams{1, rawBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> padParams{
            true, 0, rightPadding, negativeInf};
        AscendC::DataCopyPad(scoreLocal, scoresGm_, copyParams, padParams);

        if (alignedElems < static_cast<uint32_t>(inner_)) {
            AscendC::Duplicate(
                scoreLocal[alignedElems],
                negativeInf,
                static_cast<uint32_t>(inner_) - alignedElems);
        }
        AscendC::PipeBarrier<PIPE_V>();
        scoreQueue_.EnQue(scoreLocal);
    }

    __aicore__ inline int32_t MergeLevel(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t queueCount,
        int32_t srcStrideFloats)
    {
        const int32_t nextCount = (queueCount + 3) / 4;
        for (int32_t group = 0; group < nextCount; ++group) {
            const int32_t firstQueue = group * 4;
            int32_t active = queueCount - firstQueue;
            if (active > 4) {
                active = 4;
            }

            const uint32_t base = static_cast<uint32_t>(firstQueue * srcStrideFloats);
            const uint32_t dstBase = static_cast<uint32_t>(group * MERGE_STRIDE_FLOATS);

            // MrgSort 的 validBit 只接受 2/3/4 条有效输入（3/7/15）。
            // 若只剩 1 条队列，它已经有序，直接把前 k 个 pair 透传到下一层。
            if (active == 1) {
                const uint32_t prefixFloats = static_cast<uint32_t>(k_ * 2);
                const uint32_t alignedPrefixFloats = (prefixFloats + 7u) / 8u * 8u;
                AscendC::DataCopy(dst[dstBase], src[base], alignedPrefixFloats);
                AscendC::PipeBarrier<PIPE_V>();
                continue;
            }

            AscendC::MrgSort4Info params;
            params.elementLengths[0] = static_cast<uint16_t>(k_);
            params.elementLengths[1] = static_cast<uint16_t>(k_);
            params.elementLengths[2] = active >= 3 ? static_cast<uint16_t>(k_) : 0;
            params.elementLengths[3] = active >= 4 ? static_cast<uint16_t>(k_) : 0;
            params.ifExhaustedSuspension = false;
            params.validBit = static_cast<uint16_t>((1u << active) - 1u);
            params.repeatTimes = 1;

            AscendC::MrgSortSrcList<float> srcList;
            srcList.src1 = src[base];
            srcList.src2 = src[base + srcStrideFloats];
            srcList.src3 = active >= 3 ? src[base + srcStrideFloats * 2] : src[base];
            srcList.src4 = active >= 4 ? src[base + srcStrideFloats * 3] : src[base];

            AscendC::MrgSort<float>(dst[dstBase], srcList, params);
            AscendC::PipeBarrier<PIPE_V>();
        }
        return nextCount;
    }

    __aicore__ inline void SortAndMerge()
    {
        AscendC::LocalTensor<float> scoreLocal = scoreQueue_.DeQue<float>();
        AscendC::LocalTensor<int32_t> signedIndexLocal = indexBuffer_.Get<int32_t>();
        AscendC::LocalTensor<uint32_t> indexLocal =
            signedIndexLocal.ReinterpretCast<uint32_t>();
        AscendC::LocalTensor<float> sortedLocal = sortedBuffer_.Get<float>();
        AscendC::LocalTensor<float> mergeALocal = mergeABuffer_.Get<float>();
        AscendC::LocalTensor<float> mergeBLocal = mergeBBuffer_.Get<float>();
        AscendC::LocalTensor<float> outputLocal = outputQueue_.AllocTensor<float>();

        // production 不会从 GM 搬一份 index；直接在 UB 生成 0..inner-1。
        AscendC::ArithProgression<int32_t>(signedIndexLocal, 0, 1, inner_);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Sort32<float>(sortedLocal, scoreLocal, indexLocal, chunkCount_);
        AscendC::PipeBarrier<PIPE_V>();

        int32_t queueCount = MergeLevel(
            mergeALocal,
            sortedLocal,
            chunkCount_,
            CHUNK * 2);
        bool finalInA = true;

        if (queueCount > 1) {
            queueCount = MergeLevel(
                mergeBLocal,
                mergeALocal,
                queueCount,
                MERGE_STRIDE_FLOATS);
            finalInA = false;
        }
        if (queueCount > 1) {
            queueCount = MergeLevel(
                mergeALocal,
                mergeBLocal,
                queueCount,
                MERGE_STRIDE_FLOATS);
            finalInA = true;
        }

        const AscendC::LocalTensor<float>& finalLocal =
            finalInA ? mergeALocal : mergeBLocal;
        const uint32_t outputFloats = static_cast<uint32_t>(k_ * 2);
        const uint32_t alignedOutputFloats = (outputFloats + 7u) / 8u * 8u;
        AscendC::DataCopy(outputLocal, finalLocal, alignedOutputFloats);
        AscendC::PipeBarrier<PIPE_V>();

        scoreQueue_.FreeTensor(scoreLocal);
        outputQueue_.EnQue(outputLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<float> outputLocal = outputQueue_.DeQue<float>();
        const uint32_t outputBytes = static_cast<uint32_t>(k_ * 2) * sizeof(float);
        AscendC::DataCopyExtParams copyParams{1, outputBytes, 0, 0, 0};
        AscendC::DataCopyPad(outputGm_, outputLocal, copyParams);
        outputQueue_.FreeTensor(outputLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> scoreQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> indexBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sortedBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> mergeABuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> mergeBBuffer_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::GlobalTensor<float> scoresGm_;
    AscendC::GlobalTensor<float> outputGm_;
    int32_t experts_ = 0;
    int32_t inner_ = 0;
    int32_t chunkCount_ = 0;
    int32_t k_ = 0;
};

__global__ __vector__ void topk_prefix_merge_padding_probe_kernel(
    GM_ADDR scores,
    GM_ADDR outputPairs,
    int32_t experts,
    int32_t k)
{
    AscendC::InitSocState();
    PrefixMergePaddingProbeKernel op;
    op.Init(scores, outputPairs, experts, k);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

void FillInput(std::vector<float>& scores, int32_t experts, int32_t k)
{
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw = (i * 37 + experts * 11 + k * 19) % 257 - 128;
        scores[static_cast<size_t>(i)] =
            static_cast<float>(raw) / 8.0f + static_cast<float>(i) * 1.0e-5f;
    }
    scores[0] = 25.0f;
    scores[1] = -INFINITY;
}

bool RunOne(aclrtStream stream, int32_t experts, int32_t k)
{
    const int32_t inner = (experts + CHUNK - 1) / CHUNK * CHUNK;
    std::vector<float> scores(static_cast<size_t>(experts));
    FillInput(scores, experts, k);

    const size_t scoreBytes = scores.size() * sizeof(float);
    const size_t outputBytes = static_cast<size_t>(k) * 2u * sizeof(float);
    uint8_t* scoresDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    bool ok = CheckAcl(
        "aclrtMalloc(scores)",
        aclrtMalloc(reinterpret_cast<void**>(&scoresDevice), scoreBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(scores H2D)",
            aclrtMemcpy(scoresDevice, scoreBytes, scores.data(), scoreBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    std::printf(
        "RUN prefix-padding E=%d inner=%d k=%d chunks=%d\n",
        experts,
        inner,
        k,
        inner / CHUNK);
    std::fflush(stdout);

    if (ok) {
        topk_prefix_merge_padding_probe_kernel<<<1, nullptr, stream>>>(
            (GM_ADDR)scoresDevice,
            (GM_ADDR)outputDevice,
            experts,
            k);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(static_cast<size_t>(k) * 2u, 0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(output D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        std::vector<float> expected = scores;
        std::sort(expected.begin(), expected.end(), std::greater<float>());
        for (int32_t i = 0; i < k; ++i) {
            const float actualScore = output[static_cast<size_t>(i) * 2u];
            const float expectedScore = expected[static_cast<size_t>(i)];
            uint32_t actualIndex = 0;
            std::memcpy(
                &actualIndex,
                &output[static_cast<size_t>(i) * 2u + 1u],
                sizeof(actualIndex));

            if (std::fabs(actualScore - expectedScore) > 1.0e-6f) {
                std::fprintf(
                    stderr,
                    "[SCORE MISMATCH] E=%d k=%d i=%d actual=%g expected=%g index=%u\n",
                    experts,
                    k,
                    i,
                    actualScore,
                    expectedScore,
                    actualIndex);
                ok = false;
                break;
            }
            if (actualIndex >= static_cast<uint32_t>(experts) ||
                std::fabs(scores[actualIndex] - actualScore) > 1.0e-6f) {
                std::fprintf(
                    stderr,
                    "[INDEX MISMATCH] E=%d k=%d i=%d score=%g index=%u\n",
                    experts,
                    k,
                    i,
                    actualScore,
                    actualIndex);
                ok = false;
                break;
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (scoresDevice != nullptr) {
        (void)aclrtFree(scoresDevice);
    }
    return ok;
}

bool ValidateExactArgs(int32_t experts, int32_t k)
{
    if (experts < 64 || experts > MAX_EXPERTS || k < 2 || k > MAX_K || k > experts) {
        std::fprintf(stderr, "参数范围: 64<=E<=1024, 2<=k<=8\n");
        return false;
    }
    return true;
}

}  // namespace

int main(int argc, char** argv)
{
    if (argc != 1 && argc != 3) {
        std::fprintf(stderr, "用法: %s [E k]\n", argv[0]);
        return 2;
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    int32_t passed = 0;
    if (ok && argc == 3) {
        const int32_t experts = std::atoi(argv[1]);
        const int32_t k = std::atoi(argv[2]);
        ok = ValidateExactArgs(experts, k) && RunOne(stream, experts, k);
        passed = ok ? 1 : 0;
    } else if (ok) {
        const int32_t expertCases[] = {
            64, 65, 95, 96, 127, 128, 129,
            255, 256, 257,
            511, 512, 513,
            767, 768, 769,
            1023, 1024};
        for (int32_t experts : expertCases) {
            for (int32_t k = 2; ok && k <= MAX_K; ++k) {
                ok = RunOne(stream, experts, k);
                if (ok) {
                    ++passed;
                }
            }
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d local-index/padding prefix-merge cases\n", passed);
    }
    return ok ? 0 : 1;
}