#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"

namespace {

// CANN 9 CPU launch does not register the half template instance. This is
// the existing CPU-only wrapper idiom; simulator uses run_kernel below.
__global__ __vector__ void fp16_large_cpu_kernel(
    GM_ADDR input, GM_ADDR output, int32_t rows, int32_t experts,
    int32_t inner, int32_t k, int32_t blockNum)
{
    AscendC::InitSocState();
    AscendC::tiling::TopkTiling dummyTiling{};
    RunVendorTopKDispatch(VendorDispatchTag<half>{}, input, output,
                         rows, experts, inner, k, blockNum, 1, 0, dummyTiling);
    AscendC::PipeBarrier<PIPE_ALL>();
}
bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

float HalfUlp(float value)
{
    value = std::fabs(value);
    if (value == 0.0f || value < std::ldexp(1.0f, -14)) {
        return std::ldexp(1.0f, -24);
    }
    int exponent = 0;
    (void)std::frexp(value, &exponent);
    return std::ldexp(1.0f, exponent - 11);
}

bool CloseToHalfRoundedReference(float actual, float exact)
{
    if (std::isinf(exact)) {
        return std::isinf(actual) && std::signbit(actual) == std::signbit(exact);
    }
    if (std::isnan(exact)) {
        return std::isnan(actual);
    }

    const float tolerance = 0.5f * HalfUlp(exact) + 2.0e-6f;
    return std::fabs(actual - exact) <= tolerance;
}

void FillInputRow(
    std::vector<half>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
        const float value =
            static_cast<float>(raw) / 8.0f +
            static_cast<float>(i % 17) * 0.00390625f +
            static_cast<float>(row % 11) * 0.015625f;
        input[base + static_cast<size_t>(i)] = static_cast<half>(value);
    }

    input[base] = static_cast<half>(25.0f + static_cast<float>(row % 8));
    if (experts > 1) {
        input[base + 1] = static_cast<half>(-INFINITY);
    }
    if (experts > 2) {
        input[base + 2] = static_cast<half>(12.5f + static_cast<float>(row % 4));
    }
    const bool mediumCase = k >= 9 && k <= 16;
    const bool tinyCase = experts >= 225 && experts <= 256 && k >= 2 && k <= 4;
    const bool largeCase = k == 64 && experts >= 225 && experts <= 256;
    if (mediumCase || tinyCase || largeCase) {
        if (row % 8 == 0) {
            // Force all winners into one chunk, rotating through merge groups.
            std::fill(input.begin() + base, input.begin() + base + experts,
                      static_cast<half>(-20.0f));
            const int32_t chunk = (row / 8) % (experts / 32);
            const int32_t first = largeCase ? ((row / 8) % 2) * 128 : chunk * 32;
            for (int32_t i = 0; i < k; ++i) {
                input[base + first + i] = static_cast<half>((largeCase ? 100.0f : 30.0f) - i);
            }
        } else if (row % 8 == 1) {
            // Equal winners across chunk boundaries exercise duplicate scores.
            std::fill(input.begin() + base, input.begin() + base + experts,
                      static_cast<half>(-4.0f));
        } else if (row % 8 == 2) {
            // Winning values at the tail of a padded row.
            for (int32_t i = 0; i < k; ++i) {
                input[base + experts - 1 - i] = static_cast<half>((largeCase ? 100.0f : 40.0f) - i);
            }
        } else if (row % 8 == 4) {
            std::fill(input.begin() + base, input.begin() + base + experts,
                      static_cast<half>(-INFINITY));
        } else if (row % 8 == 5) {
            std::fill(input.begin() + base, input.begin() + base + experts,
                      static_cast<half>(-10000.0f));
        } else if (row % 8 == 6) {
            for (int32_t i = 0; i < experts; ++i) {
                input[base + i] = static_cast<half>(i % 3 == 0 ? 10000.0f : -10000.0f);
            }
        } else if (row % 8 == 7) {
            for (int32_t i = 0; i < experts; ++i) {
                input[base + i] = static_cast<half>(i % 5);
            }
        }
    }
}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    std::vector<half> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(half);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(half);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    std::printf(
        "RUN fp16-production rows=%d E=%d k=%d cores=%d\n",
        rows,
        experts,
        k,
        availableCoreNum);
    std::fflush(stdout);

    if (ok) {
#ifdef ASCENDC_CPU_DEBUG
        const int32_t blockNum = rows < availableCoreNum ? rows : availableCoreNum;
        fp16_large_cpu_kernel<<<blockNum, nullptr, stream>>>(
            (GM_ADDR)inputDevice, (GM_ADDR)outputDevice,
            rows, experts, (experts + 31) / 32 * 32, k, blockNum);
#else
        int64_t inputShape[] = {rows, experts};
        TensorInfo inputTensor[] = {{inputShape, 2, 1}};
        TensorGroupInfo inputInfo{inputTensor, 1};
        int64_t outputShape[] = {rows, k};
        TensorInfo outputTensor[] = {{outputShape, 2, 1}};
        TensorGroupInfo outputInfo{outputTensor, 1};
        run_kernel((GM_ADDR)inputDevice, inputInfo,
                   (GM_ADDR)outputDevice, outputInfo,
                   availableCoreNum, stream, k);
#endif
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<half> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    static_cast<float>(input[inputBase + static_cast<size_t>(i)]);
            }
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float exact = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual =
                    static_cast<float>(output[outputBase + static_cast<size_t>(i)]);
                if (!CloseToHalfRoundedReference(actual, exact)) {
                    const float hostHalf = static_cast<float>(static_cast<half>(exact));
                    const float tolerance = 0.5f * HalfUlp(exact) + 2.0e-6f;
                    std::fprintf(
                        stderr,
                        "[MISMATCH] rows=%d E=%d k=%d cores=%d row=%d i=%d actual=%g exact=%.9g hostHalf=%g tol=%g rawTop=%g\n",
                        rows,
                        experts,
                        k,
                        availableCoreNum,
                        row,
                        i,
                        actual,
                        exact,
                        hostHalf,
                        tolerance,
                        sorted[static_cast<size_t>(i)]);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));
    if (platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1") == nullptr) {
        std::fprintf(stderr, "platform initialization failed\n");
        ok = false;
    }


    struct TestCase {
        int32_t rows;
        int32_t experts;
        int32_t k;
        int32_t cores;
    };
    std::vector<TestCase> cases;
    for (const int experts : {225, 239, 240, 241, 255, 256}) {
        for (const int rows : {1, 15, 16, 17, 32, 33}) {
            cases.push_back({rows, experts, 64, 1});
        }
    }
    cases.push_back({257, 256, 64, 8});
    cases.push_back({513, 241, 64, 8});
    cases.push_back({129, 225, 64, 8});
    cases.push_back({65, 255, 64, 8});
    cases.push_back({64, 256, 64, 1});
    cases.push_back({128, 256, 64, 1});
    cases.push_back({33, 256, 4, 1});
    cases.push_back({33, 200, 16, 1});
    cases.push_back({33, 512, 10, 1});

    if (argc == 5) {
        const TestCase selected{std::atoi(argv[1]), std::atoi(argv[2]),
                                std::atoi(argv[3]), std::atoi(argv[4])};
        if (selected.rows <= 0 || selected.experts < 64 || selected.experts > 1024 ||
            selected.k < 1 || selected.k > 64 || selected.cores < 1 || selected.cores > 48) {
            std::fprintf(stderr, "Invalid profiling shape\n");
            ok = false;
        } else {
            cases = {selected};
        }
    } else if (argc != 1) {
        std::fprintf(stderr, "Usage: probe [rows experts k cores]\n");
        ok = false;
    }
    int32_t passed = 0;
    if (ok) {
        for (const auto& test : cases) {
            ok = RunOne(stream, test.rows, test.experts, test.k, test.cores);
            if (!ok) {
                break;
            }
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d fp16 production large-k cases\n", passed);
    }
    return ok ? 0 : 1;
}
