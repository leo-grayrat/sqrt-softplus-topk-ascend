#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"

namespace {

__global__ __vector__ void topk_fp32_large_production_kernel(
    GM_ADDR routerLogits,
    GM_ADDR topkScores,
    int32_t rows,
    int32_t experts,
    int32_t inner,
    int32_t k,
    int32_t blockNum)
{
    using namespace AscendC;
    InitSocState();
    TPipe pipe;
    TQue<TPosition::VECIN, 1> iq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> masks;
    pipe.InitBuffer(iq, 1, 1024 * 4);
    pipe.InitBuffer(oq, 1, 1032 * 4);
    pipe.InitBuffer(masks, 512);
    GlobalTensor<float> ig, og;
    ig.SetGlobalBuffer((__gm__ float*)routerLogits);
    og.SetGlobalBuffer((__gm__ float*)topkScores);
    for (int r=GetBlockIdx(); r<rows; r+=blockNum) {
        auto x=iq.AllocTensor<float>();
        DataCopy(x, ig[r*1024], 1024);
        iq.EnQue(x); x=iq.DeQue<float>();
        auto y=oq.AllocTensor<float>();
        Duplicate(y, -999.0f, 1032);
        PipeBarrier<PIPE_V>();
        auto mask=masks.Get<uint8_t>();
        CompareScalar(mask, x, 0.0f, CMPMODE::GE, 1024);
        PipeBarrier<PIPE_V>();
        GatherMaskParams params{1, 1, 8, 1};
        uint64_t count=0;
        GatherMask(y, x, mask.ReinterpretCast<uint32_t>(), true, 1024, params, count);
        auto ev=static_cast<event_t>(pipe.FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(ev); WaitFlag<HardEvent::V_S>(ev);
        y.SetValue(1024, static_cast<float>(static_cast<int32_t>(count)));
        auto se=static_cast<event_t>(pipe.FetchEventID(HardEvent::S_MTE3));
        SetFlag<HardEvent::S_MTE3>(se); WaitFlag<HardEvent::S_MTE3>(se);
        oq.EnQue(y); y=oq.DeQue<float>();
        DataCopy(og[r*1032], y, 1032);
        oq.FreeTensor(y); iq.FreeTensor(x);
    }

}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row)*experts;
    for (int i=0;i<experts;++i) {
        bool take=false;
        switch(row%7) {
            case 0: take=true; break;
            case 1: take=false; break;
            case 2: take=(i%2)==0; break;
            case 3: take=(i==63 || i==64 || i==127 || i==128 || i==1023); break;
            case 4: take=i>=960; break;
            case 5: take=i<64; break;
            default: take=((i*37+row*13)%101)<13;
        }
        input[base+i]=take ? float(i) : -float(i+1);
    }

}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    const int32_t inner = (experts + 31) / 32 * 32;
    const bool supported =
        (k == 1032 && experts == 1024);
    if (!supported) {
        std::fprintf(
            stderr,
            "unsupported fp32 large probe shape rows=%d E=%d inner=%d k=%d\n",
            rows,
            experts,
            inner,
            k);
        return false;
    }

    std::vector<float> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(float);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    const int32_t blockNum = rows < availableCoreNum ? rows : availableCoreNum;
    std::printf(
        "RUN fp32-large rows=%d E=%d inner=%d k=%d cores=%d\n",
        rows,
        experts,
        inner,
        k,
        blockNum);
    std::fflush(stdout);

    if (ok) {
        topk_fp32_large_production_kernel<<<blockNum, nullptr, stream>>>(
            (GM_ADDR)inputDevice,
            (GM_ADDR)outputDevice,
            rows,
            experts,
            inner,
            k,
            blockNum);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    input[inputBase + static_cast<size_t>(i)];
            }
            std::vector<float> expected;
            for (float x: sorted) if (x>=0.0f) expected.push_back(x);
            const size_t outputBase=static_cast<size_t>(row)*k;
            if (output[outputBase+1024]!=float(expected.size())) {
                std::fprintf(stderr,"COUNT row=%d actual=%g expected=%zu\n",row,output[outputBase+1024],expected.size());
                ok=false;
            }
            for(size_t i=0;i<expected.size();++i) if(output[outputBase+i]!=expected[i]) {
                std::fprintf(stderr,"VALUE row=%d i=%zu actual=%g expected=%g\n",row,i,output[outputBase+i],expected[i]);
                ok=false;break;
            }

        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    struct TestCase {
        int32_t rows;
        int32_t experts;
        int32_t k;
        int32_t cores;
    };
    std::vector<TestCase> cases = {{7,1024,1032,1},{15,1024,1032,8},{65,1024,1032,8}};

    if (argc == 5) {
        cases = {{std::atoi(argv[1]), std::atoi(argv[2]), std::atoi(argv[3]), std::atoi(argv[4])}};
        if (cases[0].rows < 1 || cases[0].cores < 1 || cases[0].cores > 48) { ok = false; }
    } else if (argc != 1) { ok = false; }
    int32_t passed = 0;
    if (ok) {
        for (const auto& test : cases) {
            ok = RunOne(stream, test.rows, test.experts, test.k, test.cores);
            if (!ok) {
                break;
            }
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d whole-row compaction cases\n", passed);
    }
    return ok ? 0 : 1;
}
