#include <cmath>
#include "kernel_operator.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

namespace {

constexpr uint32_t ALIGN_BYTES = 32;

constexpr uint32_t AlignUpBytes(uint32_t value)
{
    return (value + ALIGN_BYTES - 1) / ALIGN_BYTES * ALIGN_BYTES;
}

__aicore__ inline void StableSoftplusSqrt(
    const AscendC::LocalTensor<float>& values,
    const AscendC::LocalTensor<float>& tmp,
    uint32_t count)
{
    // softplus(x) = max(x, 0) + log(1 + exp(-abs(x)))
    AscendC::Abs(tmp, values, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Muls(tmp, tmp, -1.0f, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Exp(tmp, tmp, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Adds(tmp, tmp, 1.0f, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Ln(tmp, tmp, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Maxs(values, values, 0.0f, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Add(values, values, tmp, count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Sqrt(values, values, count);
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void TransformSelected(
    const AscendC::LocalTensor<float>& values,
    const AscendC::LocalTensor<float>&,
    const AscendC::LocalTensor<float>& tmp,
    uint32_t count)
{
    StableSoftplusSqrt(values, tmp, count);
}

__aicore__ inline void TransformSelected(
    const AscendC::LocalTensor<half>& values,
    const AscendC::LocalTensor<float>& work,
    const AscendC::LocalTensor<float>& tmp,
    uint32_t count)
{
    AscendC::Cast(work, values, AscendC::RoundMode::CAST_NONE, count);
    AscendC::PipeBarrier<PIPE_V>();
    StableSoftplusSqrt(work, tmp, count);
    AscendC::Cast(values, work, AscendC::RoundMode::CAST_RINT, count);
    AscendC::PipeBarrier<PIPE_V>();
}

template <typename T>
class SqrtSoftplusTopKKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR routerLogits,
        GM_ADDR topkScores,
        int32_t rows,
        int32_t experts,
        int32_t inner,
        int32_t k,
        int32_t blockNum,
        uint32_t topkTmpBytes,
        const AscendC::tiling::TopkTiling& topkTiling)
    {
        rows_ = rows;
        experts_ = experts;
        inner_ = inner;
        k_ = k;
        blockNum_ = blockNum;
        topkTiling_ = topkTiling;

        inputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(routerLogits));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(topkScores));

        const uint32_t inputBytes = static_cast<uint32_t>(static_cast<uint64_t>(inner_) * sizeof(T));
        const uint32_t rawValueBytes = static_cast<uint32_t>(static_cast<uint64_t>(k_) * sizeof(T));
        const uint32_t valueBytes = (rawValueBytes + 31u) / 32u * 32u;
        const uint32_t rawIndexBytes = static_cast<uint32_t>(static_cast<uint64_t>(k_) * sizeof(int32_t));
        const uint32_t indexBytes = (rawIndexBytes + 31u) / 32u * 32u;
        const uint32_t rawFloatWorkBytes = static_cast<uint32_t>(static_cast<uint64_t>(k_) * sizeof(float));
        const uint32_t floatWorkBytes = (rawFloatWorkBytes + 31u) / 32u * 32u;

        pipe_.InitBuffer(inputQueue_, 1, inputBytes);
        pipe_.InitBuffer(outputQueue_, 1, valueBytes);
        pipe_.InitBuffer(indexBuffer_, indexBytes);
        pipe_.InitBuffer(floatWorkBuffer_, floatWorkBytes);
        pipe_.InitBuffer(floatTmpBuffer_, floatWorkBytes);
        pipe_.InitBuffer(topkTmpBuffer_, topkTmpBytes);
    }

    __aicore__ inline void Process()
    {
        const int32_t blockIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
        for (int32_t row = blockIdx; row < rows_; row += blockNum_) {
            ProcessRow(row);
        }
    }

private:
    __aicore__ inline void ProcessRow(int32_t row)
    {
        AscendC::LocalTensor<T> srcLocal = inputQueue_.AllocTensor<T>();

        const uint32_t rawBytes = static_cast<uint32_t>(static_cast<uint64_t>(experts_) * sizeof(T));
        const uint32_t copyAlignedBytes = (rawBytes + 31u) / 32u * 32u;
        const uint32_t copyAlignedElems = copyAlignedBytes / static_cast<uint32_t>(sizeof(T));
        const uint8_t rightPadding = static_cast<uint8_t>(copyAlignedElems - experts_);
        const T negativeInf = static_cast<T>(-INFINITY);

        AscendC::DataCopyExtParams copyInParams{1, rawBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{true, 0, rightPadding, negativeInf};
        AscendC::DataCopyPad(
            srcLocal,
            inputGm_[static_cast<int64_t>(row) * experts_],
            copyInParams,
            padParams);
        inputQueue_.EnQue(srcLocal);
        srcLocal = inputQueue_.DeQue<T>();

        if (copyAlignedElems < static_cast<uint32_t>(inner_)) {
            AscendC::Duplicate(
                srcLocal[copyAlignedElems],
                negativeInf,
                static_cast<uint32_t>(inner_) - copyAlignedElems);
            AscendC::PipeBarrier<PIPE_V>();
        }

        AscendC::LocalTensor<T> dstLocal = outputQueue_.AllocTensor<T>();
        AscendC::LocalTensor<int32_t> dstIndexLocal = indexBuffer_.Get<int32_t>();
        AscendC::LocalTensor<float> floatWork = floatWorkBuffer_.Get<float>();
        AscendC::LocalTensor<float> floatTmp = floatTmpBuffer_.Get<float>();
        AscendC::LocalTensor<uint8_t> topkTmp = topkTmpBuffer_.Get<uint8_t>();
        AscendC::LocalTensor<int32_t> srcIndexLocal;
        AscendC::LocalTensor<bool> finishLocal;

        AscendC::TopKInfo topkInfo;
        topkInfo.outter = 1;
        topkInfo.inner = inner_;
        topkInfo.n = experts_;

        AscendC::TopK<T, false, false, false, AscendC::TopKMode::TOPK_NORMAL>(
            dstLocal,
            dstIndexLocal,
            srcLocal,
            srcIndexLocal,
            finishLocal,
            topkTmp,
            k_,
            topkTiling_,
            topkInfo,
            true);
        AscendC::PipeBarrier<PIPE_V>();

        TransformSelected(dstLocal, floatWork, floatTmp, static_cast<uint32_t>(k_));

        inputQueue_.FreeTensor(srcLocal);
        outputQueue_.EnQue(dstLocal);

        AscendC::LocalTensor<T> outLocal = outputQueue_.DeQue<T>();
        const uint32_t outputBytes = static_cast<uint32_t>(static_cast<uint64_t>(k_) * sizeof(T));
        AscendC::DataCopyExtParams copyOutParams{1, outputBytes, 0, 0, 0};
        AscendC::DataCopyPad(
            outputGm_[static_cast<int64_t>(row) * k_],
            outLocal,
            copyOutParams);
        outputQueue_.FreeTensor(outLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> indexBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatWorkBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatTmpBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> topkTmpBuffer_;
    AscendC::GlobalTensor<T> inputGm_;
    AscendC::GlobalTensor<T> outputGm_;

    int32_t rows_ = 0;
    int32_t experts_ = 0;
    int32_t inner_ = 0;
    int32_t k_ = 0;
    int32_t blockNum_ = 0;
    AscendC::tiling::TopkTiling topkTiling_;
};

template <typename T>
__global__ __vector__ void sqrt_softplus_top_k_custom(
    GM_ADDR routerLogits,
    GM_ADDR topkScores,
    int32_t rows,
    int32_t experts,
    int32_t inner,
    int32_t k,
    int32_t blockNum,
    uint32_t topkTmpBytes,
    AscendC::tiling::TopkTiling topkTiling)
{
    AscendC::InitSocState();
    SqrtSoftplusTopKKernel<T> op;
    op.Init(
        routerLogits,
        topkScores,
        rows,
        experts,
        inner,
        k,
        blockNum,
        topkTmpBytes,
        topkTiling);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool BuildTopKTiling(
    int32_t inner,
    int32_t k,
    uint32_t dtypeSize,
    AscendC::tiling::TopkTiling& topkTiling,
    uint32_t& topkTmpBytes)
{
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }

    const bool isReuseSource = false;
    const bool isInitIndex = false;
    const bool isLargest = true;
    const auto mode = AscendC::TopKMode::TOPK_NORMAL;

    if (!AscendC::TopKTilingFunc(
            *platform,
            inner,
            1,
            k,
            dtypeSize,
            isInitIndex,
            mode,
            isLargest,
            topkTiling)) {
        return false;
    }

    uint32_t maxTmpBytes = 0;
    uint32_t minTmpBytes = 0;
    if (!AscendC::GetTopKMaxMinTmpSize(
            *platform,
            inner,
            1,
            isReuseSource,
            isInitIndex,
            mode,
            isLargest,
            dtypeSize,
            maxTmpBytes,
            minTmpBytes)) {
        return false;
    }

    topkTmpBytes = AlignUpBytes(minTmpBytes);
    return true;
}

}  // namespace

extern "C" void run_kernel(
    GM_ADDR router_logits,
    const TensorGroupInfo& info_router_logits,
    GM_ADDR topk_scores,
    const TensorGroupInfo& info_topk_scores,
    int64_t availableCoreNum,
    aclrtStream stream,
    int64_t k)
{
    (void)info_topk_scores;

    if (info_router_logits.numTensors != 1 || info_router_logits.tensors[0].numDims != 2) {
        return;
    }

    const int64_t rows64 = info_router_logits.tensors[0].shape[0];
    const int64_t experts64 = info_router_logits.tensors[0].shape[1];
    if (rows64 <= 0 || rows64 > 131072 || experts64 < 64 || experts64 > 1024 ||
        k <= 0 || k > 64 || k > experts64 || availableCoreNum <= 0) {
        return;
    }

    const int32_t rows = static_cast<int32_t>(rows64);
    const int32_t experts = static_cast<int32_t>(experts64);
    const int32_t inner = (experts + 31) / 32 * 32;
    const int32_t blockNum = rows < availableCoreNum ? rows : static_cast<int32_t>(availableCoreNum);
    const int32_t k32 = static_cast<int32_t>(k);
    const int32_t dtype = info_router_logits.tensors[0].dtype;

    AscendC::tiling::TopkTiling topkTiling;
    uint32_t topkTmpBytes = 0;

    if (dtype == 0) {
        if (!BuildTopKTiling(inner, k32, sizeof(float), topkTiling, topkTmpBytes)) {
            return;
        }
        sqrt_softplus_top_k_custom<float><<<blockNum, nullptr, stream>>>(
            router_logits,
            topk_scores,
            rows,
            experts,
            inner,
            k32,
            blockNum,
            topkTmpBytes,
            topkTiling);
        return;
    }

    if (dtype == 1) {
        if (!BuildTopKTiling(inner, k32, sizeof(half), topkTiling, topkTmpBytes)) {
            return;
        }
        sqrt_softplus_top_k_custom<half><<<blockNum, nullptr, stream>>>(
            router_logits,
            topk_scores,
            rows,
            experts,
            inner,
            k32,
            blockNum,
            topkTmpBytes,
            topkTiling);
        return;
    }
}
