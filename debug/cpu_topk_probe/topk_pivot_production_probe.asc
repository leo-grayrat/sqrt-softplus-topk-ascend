#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

// 直接包含正式提交 kernel，验证 run_kernel 的真实 dispatch。
#include "../../submission/kernel.asc"

namespace {

enum class InputMode : int32_t {
    Normal = 0,
    Negative = 1,
    Ties = 2,
    PositiveInf = 3,
};

const char* ModeName(InputMode mode)
{
    switch (mode) {
        case InputMode::Normal: return "normal";
        case InputMode::Negative: return "negative";
        case InputMode::Ties: return "ties";
        case InputMode::PositiveInf: return "inf";
    }
    return "unknown";
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus = x > 20.0f ? x : std::log1p(std::exp(x));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k,
    InputMode mode)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        float value = 0.0f;
        if (mode == InputMode::Normal || mode == InputMode::PositiveInf) {
            const int32_t raw =
                (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
            value = static_cast<float>(raw) / 32.0f
                + static_cast<float>(i) * 1.0e-6f
                + static_cast<float>(row) * 1.0e-4f;
        } else if (mode == InputMode::Negative) {
            value = -0.25f
                - static_cast<float>((i * 17 + row * 11) % 113) / 16.0f
                - static_cast<float>(i) * 1.0e-6f;
        } else {
            // 大量相等值：大 E 时 pivot 无法在 6 轮内压到 <=64，应走精确 fallback。
            value = (i % 11 == 0) ? 2.0f : 1.0f;
        }
        input[base + static_cast<size_t>(i)] = value;
    }

    if (mode == InputMode::PositiveInf) {
        input[base] = INFINITY;
    }
}

bool SameValue(float actual, float expected)
{
    if (std::isinf(expected)) {
        return std::isinf(actual) && std::signbit(actual) == std::signbit(expected);
    }
    return std::fabs(actual - expected) <= 1.0e-5f;
}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    InputMode mode)
{
    std::vector<float> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k, mode);
    }

    const size_t inputBytes = input.size() * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(float);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    int64_t inputShape[] = {rows, experts};
    TensorInfo inputTensor[] = {{inputShape, 2, 0}};
    TensorGroupInfo inputInfo{inputTensor, 1};
    int64_t outputShape[] = {rows, k};
    TensorInfo outputTensor[] = {{outputShape, 2, 0}};
    TensorGroupInfo outputInfo{outputTensor, 1};

    std::printf(
        "RUN pivot-production mode=%s rows=%d E=%d k=%d\n",
        ModeName(mode), rows, experts, k);
    std::fflush(stdout);

    if (ok) {
        run_kernel(
            (GM_ADDR)inputDevice,
            inputInfo,
            (GM_ADDR)outputDevice,
            outputInfo,
            1,
            stream,
            k);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k),
        0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(
                input.begin() + static_cast<std::ptrdiff_t>(inputBase),
                input.begin() + static_cast<std::ptrdiff_t>(
                    inputBase + static_cast<size_t>(experts)));
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float expected = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual = output[outputBase + static_cast<size_t>(i)];
                if (!SameValue(actual, expected)) {
                    std::fprintf(
                        stderr,
                        "[MISMATCH] mode=%s rows=%d E=%d k=%d row=%d i=%d actual=%g expected=%g\n",
                        ModeName(mode),
                        rows,
                        experts,
                        k,
                        row,
                        i,
                        actual,
                        expected);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    int32_t passed = 0;
    if (ok) {
        const int32_t expertCases[] = {64, 65, 128, 257, 1024};
        const int32_t kCases[] = {2, 4, 8};
        const InputMode modes[] = {
            InputMode::Normal,
            InputMode::Negative,
            InputMode::Ties,
            InputMode::PositiveInf,
        };

        for (InputMode mode : modes) {
            for (int32_t experts : expertCases) {
                for (int32_t k : kCases) {
                    ok = RunOne(stream, 1, experts, k, mode);
                    if (!ok) {
                        break;
                    }
                    ++passed;
                }
                if (!ok) {
                    break;
                }
            }
            if (!ok) {
                break;
            }
        }

        // 多行只需要再覆盖正常 fast path，验证 row loop / GM stride。
        if (ok) {
            for (int32_t experts : expertCases) {
                for (int32_t k : kCases) {
                    ok = RunOne(stream, 3, experts, k, InputMode::Normal);
                    if (!ok) {
                        break;
                    }
                    ++passed;
                }
                if (!ok) {
                    break;
                }
            }
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d pivot production cases\n", passed);
    }
    return ok ? 0 : 1;
}
