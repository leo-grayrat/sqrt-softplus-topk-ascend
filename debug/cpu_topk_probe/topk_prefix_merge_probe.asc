#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <numeric>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace {

constexpr int32_t EXPERTS = 128;
constexpr int32_t CHUNK = 32;
constexpr int32_t CHUNKS = EXPERTS / CHUNK;
constexpr int32_t SORT_REPEAT = CHUNKS;
constexpr uint32_t SCORE_BYTES = EXPERTS * sizeof(float);
constexpr uint32_t INDEX_BYTES = EXPERTS * sizeof(uint32_t);
constexpr uint32_t PAIR_FLOATS = EXPERTS * 2;
constexpr uint32_t PAIR_BYTES = PAIR_FLOATS * sizeof(float);

class PrefixMergeProbeKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR scores,
        GM_ADDR indices,
        GM_ADDR outputPairs,
        int32_t k)
    {
        k_ = k;
        scoresGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scores));
        indicesGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(indices));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outputPairs));

        // 尺寸都取 256B 的倍数，使官方 Sort32 样例中的 256B 输出对齐要求容易满足。
        pipe_.InitBuffer(scoreQueue_, 1, SCORE_BYTES);
        pipe_.InitBuffer(indexQueue_, 1, INDEX_BYTES);
        pipe_.InitBuffer(sortedQueue_, 1, PAIR_BYTES);
        pipe_.InitBuffer(mergedQueue_, 1, PAIR_BYTES);
    }

    __aicore__ inline void Process()
    {
        CopyIn();
        SortAndMerge();
        CopyOut();
    }

private:
    __aicore__ inline void CopyIn()
    {
        AscendC::LocalTensor<float> scoreLocal = scoreQueue_.AllocTensor<float>();
        AscendC::LocalTensor<uint32_t> indexLocal = indexQueue_.AllocTensor<uint32_t>();
        AscendC::DataCopy(scoreLocal, scoresGm_, EXPERTS);
        AscendC::DataCopy(indexLocal, indicesGm_, EXPERTS);
        scoreQueue_.EnQue(scoreLocal);
        indexQueue_.EnQue(indexLocal);
    }

    __aicore__ inline void SortAndMerge()
    {
        AscendC::LocalTensor<float> scoreLocal = scoreQueue_.DeQue<float>();
        AscendC::LocalTensor<uint32_t> indexLocal = indexQueue_.DeQue<uint32_t>();
        AscendC::LocalTensor<float> sortedLocal = sortedQueue_.AllocTensor<float>();
        AscendC::LocalTensor<float> mergedLocal = mergedQueue_.AllocTensor<float>();

        // 一次 Sort32 得到 4 条各含 32 个 (score,index) 的降序队列。
        AscendC::Sort32<float>(sortedLocal, scoreLocal, indexLocal, SORT_REPEAT);
        AscendC::PipeBarrier<PIPE_V>();

        // 关键实验：每条 32-pair 队列只向 MrgSort 暴露前 k 个 pair。
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = static_cast<uint16_t>(k_);
        params.elementLengths[1] = static_cast<uint16_t>(k_);
        params.elementLengths[2] = static_cast<uint16_t>(k_);
        params.elementLengths[3] = static_cast<uint16_t>(k_);
        params.ifExhaustedSuspension = false;
        params.validBit = 0b1111;
        params.repeatTimes = 1;

        AscendC::MrgSortSrcList<float> srcList;
        // 每个逻辑 pair 占 8B，即在 LocalTensor<float> 中占 2 个元素。
        srcList.src1 = sortedLocal[0];
        srcList.src2 = sortedLocal[CHUNK * 2];
        srcList.src3 = sortedLocal[CHUNK * 2 * 2];
        srcList.src4 = sortedLocal[CHUNK * 3 * 2];
        AscendC::MrgSort<float>(mergedLocal, srcList, params);
        AscendC::PipeBarrier<PIPE_V>();

        scoreQueue_.FreeTensor(scoreLocal);
        indexQueue_.FreeTensor(indexLocal);
        sortedQueue_.FreeTensor(sortedLocal);
        mergedQueue_.EnQue(mergedLocal);
    }

    __aicore__ inline void CopyOut()
    {
        AscendC::LocalTensor<float> mergedLocal = mergedQueue_.DeQue<float>();
        const uint32_t outputBytes = static_cast<uint32_t>(k_ * 2 * sizeof(float));
        AscendC::DataCopyExtParams copyOutParams{1, outputBytes, 0, 0, 0};
        AscendC::DataCopyPad(outputGm_, mergedLocal, copyOutParams);
        mergedQueue_.FreeTensor(mergedLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> scoreQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> indexQueue_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> sortedQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> mergedQueue_;
    AscendC::GlobalTensor<float> scoresGm_;
    AscendC::GlobalTensor<uint32_t> indicesGm_;
    AscendC::GlobalTensor<float> outputGm_;
    int32_t k_ = 0;
};

__global__ __vector__ void topk_prefix_merge_probe_kernel(
    GM_ADDR scores,
    GM_ADDR indices,
    GM_ADDR outputPairs,
    int32_t k)
{
    AscendC::InitSocState();
    PrefixMergeProbeKernel op;
    op.Init(scores, indices, outputPairs, k);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

void FillInput(std::vector<float>& scores)
{
    for (int32_t i = 0; i < EXPERTS; ++i) {
        const int32_t raw = (i * 37 + 19) % 257 - 128;
        scores[static_cast<size_t>(i)] =
            static_cast<float>(raw) / 8.0f + static_cast<float>(i) * 1.0e-5f;
    }
    scores[0] = 25.0f;
    scores[1] = -INFINITY;
}

bool RunOne(aclrtStream stream, int32_t k)
{
    std::vector<float> scores(EXPERTS);
    FillInput(scores);
    std::vector<uint32_t> indices(EXPERTS);
    std::iota(indices.begin(), indices.end(), 0u);

    const size_t scoreBytes = scores.size() * sizeof(float);
    const size_t indexBytes = indices.size() * sizeof(uint32_t);
    const size_t outputBytes = static_cast<size_t>(k) * 2u * sizeof(float);

    uint8_t* scoresDevice = nullptr;
    uint8_t* indicesDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    bool ok = CheckAcl(
        "aclrtMalloc(scores)",
        aclrtMalloc(reinterpret_cast<void**>(&scoresDevice), scoreBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(indices)",
            aclrtMalloc(reinterpret_cast<void**>(&indicesDevice), indexBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(scores H2D)",
            aclrtMemcpy(scoresDevice, scoreBytes, scores.data(), scoreBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(indices H2D)",
            aclrtMemcpy(indicesDevice, indexBytes, indices.data(), indexBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    std::printf("RUN prefix-merge E=%d k=%d\n", EXPERTS, k);
    std::fflush(stdout);
    if (ok) {
        topk_prefix_merge_probe_kernel<<<1, nullptr, stream>>>(
            (GM_ADDR)scoresDevice,
            (GM_ADDR)indicesDevice,
            (GM_ADDR)outputDevice,
            k);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(static_cast<size_t>(k) * 2u, 0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(output D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        std::vector<float> expected = scores;
        std::sort(expected.begin(), expected.end(), std::greater<float>());
        for (int32_t i = 0; i < k; ++i) {
            const float actualScore = output[static_cast<size_t>(i) * 2u];
            const float expectedScore = expected[static_cast<size_t>(i)];
            uint32_t actualIndex = 0;
            std::memcpy(
                &actualIndex,
                &output[static_cast<size_t>(i) * 2u + 1u],
                sizeof(actualIndex));

            if (std::fabs(actualScore - expectedScore) > 1.0e-6f) {
                std::fprintf(
                    stderr,
                    "[SCORE MISMATCH] k=%d i=%d actual=%g expected=%g index=%u\n",
                    k,
                    i,
                    actualScore,
                    expectedScore,
                    actualIndex);
                ok = false;
                break;
            }
            if (actualIndex >= static_cast<uint32_t>(EXPERTS) ||
                std::fabs(scores[actualIndex] - actualScore) > 1.0e-6f) {
                std::fprintf(
                    stderr,
                    "[INDEX MISMATCH] k=%d i=%d score=%g index=%u\n",
                    k,
                    i,
                    actualScore,
                    actualIndex);
                ok = false;
                break;
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (indicesDevice != nullptr) {
        (void)aclrtFree(indicesDevice);
    }
    if (scoresDevice != nullptr) {
        (void)aclrtFree(scoresDevice);
    }
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    int32_t firstK = 2;
    int32_t lastK = 8;
    if (argc == 2) {
        firstK = std::atoi(argv[1]);
        lastK = firstK;
        if (firstK < 2 || firstK > 8) {
            std::fprintf(stderr, "参数范围: 2<=k<=8\n");
            return 2;
        }
    } else if (argc != 1) {
        std::fprintf(stderr, "用法: %s [k]\n", argv[0]);
        return 2;
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    int32_t passed = 0;
    for (int32_t k = firstK; ok && k <= lastK; ++k) {
        ok = RunOne(stream, k);
        if (ok) {
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d prefix-merge cases\n", passed);
    }
    return ok ? 0 : 1;
}
