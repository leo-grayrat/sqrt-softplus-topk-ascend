#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"

namespace {

constexpr int32_t LARGE_SORT_K = 32;
constexpr int32_t LARGE_KEEP_K = 64;
constexpr int32_t LARGE_PAIR_FLOATS_32 = LARGE_SORT_K * 2;
constexpr int32_t LARGE_PAIR_FLOATS_64 = LARGE_KEEP_K * 2;

class Fp32VendorLargeProbeKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR routerLogits,
        GM_ADDR topkScores,
        int32_t rows,
        int32_t experts,
        int32_t inner,
        int32_t k,
        int32_t blockNum)
    {
        rows_ = rows;
        experts_ = experts;
        inner_ = inner;
        k_ = k;
        blockNum_ = blockNum;
        batchRows_ = SelectVendorBatchRows(rows_, blockNum_, inner_);
        groupCount_ = (rows_ + batchRows_ - 1) / batchRows_;
        activeBlockNum_ = groupCount_ < blockNum_ ? groupCount_ : blockNum_;

        const uint32_t rawBytes = static_cast<uint32_t>(experts_) * sizeof(float);
        const uint32_t copyAlignedBytes =
            (rawBytes + ALIGN_BYTES - 1u) / ALIGN_BYTES * ALIGN_BYTES;
        copyAlignedElems_ = static_cast<int32_t>(copyAlignedBytes / sizeof(float));

        inputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(routerLogits));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(topkScores));

        const uint32_t batchStageBytes =
            static_cast<uint32_t>(batchRows_ * copyAlignedElems_) * sizeof(float);
        const uint32_t batchInputBytes =
            static_cast<uint32_t>(batchRows_ * inner_) * sizeof(float);
        const uint32_t batchPairBytes = batchInputBytes * 2u;
        const uint32_t batchOutputBytes =
            static_cast<uint32_t>(batchRows_ * k_) * sizeof(float);

        pipe_.InitBuffer(inputQueue_, 2, batchStageBytes);
        pipe_.InitBuffer(inputBuffer_, batchInputBytes);
        pipe_.InitBuffer(indexBuffer_, batchInputBytes);
        pipe_.InitBuffer(pairABuffer_, batchPairBytes);
        pipe_.InitBuffer(pairBBuffer_, batchPairBytes);
        pipe_.InitBuffer(outputQueue_, 1, batchOutputBytes);
        pipe_.InitBuffer(tmpBuffer_, batchOutputBytes);
        pipe_.InitBuffer(patternBuffer_, ALIGN_BYTES);
    }

    __aicore__ inline void Process()
    {
        const int32_t blockIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
        if (blockIdx >= activeBlockNum_) {
            return;
        }

        InitIndexBatch();
        InitValuePattern();

        int32_t group = blockIdx;
        CopyInGroup(group);
        while (group < groupCount_) {
            const int32_t nextGroup = group + activeBlockNum_;
            if (nextGroup < groupCount_) {
                CopyInGroup(nextGroup);
            }
            ComputeGroup(group);
            group = nextGroup;
        }
    }

private:
    __aicore__ inline int32_t GroupValidRows(int32_t group) const
    {
        const int32_t firstRow = group * batchRows_;
        int32_t validRows = rows_ - firstRow;
        if (validRows > batchRows_) {
            validRows = batchRows_;
        }
        return validRows;
    }

    __aicore__ inline void InitIndexBatch()
    {
        AscendC::LocalTensor<int32_t> index = indexBuffer_.Get<int32_t>();
        AscendC::Duplicate(
            index,
            static_cast<int32_t>(0),
            static_cast<uint32_t>(batchRows_ * inner_));
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void InitValuePattern()
    {
        using namespace AscendC;
        LocalTensor<uint32_t> pattern = patternBuffer_.Get<uint32_t>();
        pattern.SetValue(0, 0x55555555u);
        pattern.SetValue(1, 0x55555555u);
        auto eventID = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(eventID);
        WaitFlag<HardEvent::S_V>(eventID);
    }

    __aicore__ inline void CopyInGroup(int32_t group)
    {
        AscendC::LocalTensor<float> staging = inputQueue_.AllocTensor<float>();
        const int32_t firstRow = group * batchRows_;
        const int32_t validRows = GroupValidRows(group);
        const uint32_t rowBytes = static_cast<uint32_t>(experts_) * sizeof(float);
        const uint8_t rightPadding = static_cast<uint8_t>(copyAlignedElems_ - experts_);

        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = static_cast<uint16_t>(validRows);
        copyParams.blockLen = rowBytes;
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        copyParams.rsv = 0;
        AscendC::DataCopyPadExtParams<float> padParams{
            true, 0, rightPadding, -INFINITY};

        AscendC::DataCopyPad(
            staging,
            inputGm_[static_cast<int64_t>(firstRow) * experts_],
            copyParams,
            padParams);
        inputQueue_.EnQue(staging);
    }

    __aicore__ inline void RearrangeRows(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& staging,
        int32_t validRows)
    {
        AscendC::Duplicate(
            dst,
            -INFINITY,
            static_cast<uint32_t>(validRows * inner_));
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::DataCopyParams params;
        params.blockCount = static_cast<uint16_t>(validRows);
        params.blockLen = static_cast<uint16_t>(copyAlignedElems_ / 8);
        params.srcStride = 0;
        params.dstStride = static_cast<uint16_t>((inner_ - copyAlignedElems_) / 8);
        AscendC::DataCopy(dst, staging, params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void MergeFour32(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t repeatTimes)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = LARGE_SORT_K;
        params.elementLengths[1] = LARGE_SORT_K;
        params.elementLengths[2] = LARGE_SORT_K;
        params.elementLengths[3] = LARGE_SORT_K;
        params.ifExhaustedSuspension = false;
        params.validBit = 15;
        params.repeatTimes = static_cast<uint16_t>(repeatTimes);

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[LARGE_PAIR_FLOATS_32];
        srcList.src3 = src[LARGE_PAIR_FLOATS_32 * 2];
        srcList.src4 = src[LARGE_PAIR_FLOATS_32 * 3];
        AscendC::MrgSort<float>(dst, srcList, params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void MergeFour64(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t repeatTimes)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = LARGE_KEEP_K;
        params.elementLengths[1] = LARGE_KEEP_K;
        params.elementLengths[2] = LARGE_KEEP_K;
        params.elementLengths[3] = LARGE_KEEP_K;
        params.ifExhaustedSuspension = false;
        params.validBit = 15;
        params.repeatTimes = static_cast<uint16_t>(repeatTimes);

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[LARGE_PAIR_FLOATS_64];
        srcList.src3 = src[LARGE_PAIR_FLOATS_64 * 2];
        srcList.src4 = src[LARGE_PAIR_FLOATS_64 * 3];
        AscendC::MrgSort<float>(dst, srcList, params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void MergeTwo64(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t repeatTimes)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = LARGE_KEEP_K;
        params.elementLengths[1] = LARGE_KEEP_K;
        params.elementLengths[2] = 0;
        params.elementLengths[3] = 0;
        params.ifExhaustedSuspension = false;
        params.validBit = 3;
        params.repeatTimes = static_cast<uint16_t>(repeatTimes);

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[LARGE_PAIR_FLOATS_64];
        srcList.src3 = src[0];
        srcList.src4 = src[0];
        AscendC::MrgSort<float>(dst, srcList, params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void CopyPrefixPairs(
        const AscendC::LocalTensor<float>& dst,
        int32_t dstRowFloats,
        uint32_t dstBase,
        const AscendC::LocalTensor<float>& src,
        int32_t srcRowFloats,
        uint32_t srcBase,
        int32_t pairCount,
        int32_t rows)
    {
        const int32_t copyFloats = pairCount * 2;
        AscendC::DataCopyParams params;
        params.blockCount = static_cast<uint16_t>(rows);
        params.blockLen = static_cast<uint16_t>(copyFloats / 8);
        params.srcStride =
            static_cast<uint16_t>((srcRowFloats - copyFloats) / 8);
        params.dstStride =
            static_cast<uint16_t>((dstRowFloats - copyFloats) / 8);
        AscendC::DataCopy(dst[dstBase], src[srcBase], params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void PackTop64From128Lists(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t rows)
    {
        constexpr int32_t srcRowFloats = 1024 * 2;
        constexpr int32_t dstRowFloats = 8 * LARGE_PAIR_FLOATS_64;
        constexpr int32_t srcListStrideFloats = 128 * 2;
        for (int32_t list = 0; list < 8; ++list) {
            CopyPrefixPairs(
                dst,
                dstRowFloats,
                static_cast<uint32_t>(list * LARGE_PAIR_FLOATS_64),
                src,
                srcRowFloats,
                static_cast<uint32_t>(list * srcListStrideFloats),
                LARGE_KEEP_K,
                rows);
        }
    }

    __aicore__ inline void PackTop64From256Lists(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t rows)
    {
        constexpr int32_t srcRowFloats = 2 * 256 * 2;
        constexpr int32_t dstRowFloats = 2 * LARGE_PAIR_FLOATS_64;
        constexpr int32_t srcListStrideFloats = 256 * 2;
        for (int32_t list = 0; list < 2; ++list) {
            CopyPrefixPairs(
                dst,
                dstRowFloats,
                static_cast<uint32_t>(list * LARGE_PAIR_FLOATS_64),
                src,
                srcRowFloats,
                static_cast<uint32_t>(list * srcListStrideFloats),
                LARGE_KEEP_K,
                rows);
        }
    }

    __aicore__ inline void BuildK32Pairs(
        const AscendC::LocalTensor<float>& compact,
        const AscendC::LocalTensor<float>& merged,
        int32_t rows)
    {
        MergeFour32(merged, compact, rows);
        CopyPrefixPairs(
            compact,
            LARGE_PAIR_FLOATS_32,
            0,
            merged,
            128 * 2,
            0,
            LARGE_SORT_K,
            rows);
    }

    __aicore__ inline void BuildK64Pairs(
        const AscendC::LocalTensor<float>& pairA,
        const AscendC::LocalTensor<float>& pairB,
        int32_t rows)
    {
        MergeFour32(pairB, pairA, rows * 8);
        PackTop64From128Lists(pairA, pairB, rows);

        MergeFour64(pairB, pairA, rows * 2);
        PackTop64From256Lists(pairA, pairB, rows);

        MergeTwo64(pairB, pairA, rows);
        CopyPrefixPairs(
            pairA,
            LARGE_PAIR_FLOATS_64,
            0,
            pairB,
            128 * 2,
            0,
            LARGE_KEEP_K,
            rows);
    }

    __aicore__ inline void ExtractValues(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& compactPairs,
        int32_t rows)
    {
        using namespace AscendC;
        LocalTensor<uint32_t> pattern = patternBuffer_.Get<uint32_t>();
        GatherMaskParams params;
        uint64_t rsvdCnt = 0;
        params.src0BlockStride = 1;
        params.repeatTimes = static_cast<uint8_t>(
            k_ == LARGE_SORT_K ? rows : rows * 2);
        params.src0RepeatStride = 8;
        params.src1RepeatStride = 0;
        GatherMask(
            dst.ReinterpretCast<int32_t>(),
            compactPairs.ReinterpretCast<int32_t>(),
            pattern,
            true,
            VENDOR_GATHER_REPEAT,
            params,
            rsvdCnt);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ComputeGroup(int32_t group)
    {
        const int32_t firstRow = group * batchRows_;
        const int32_t validRows = GroupValidRows(group);

        AscendC::LocalTensor<float> staging = inputQueue_.DeQue<float>();
        AscendC::LocalTensor<float> input = staging;
        if (copyAlignedElems_ < inner_) {
            input = inputBuffer_.Get<float>();
            RearrangeRows(input, staging, validRows);
        }

        AscendC::LocalTensor<int32_t> signedIndex = indexBuffer_.Get<int32_t>();
        AscendC::LocalTensor<uint32_t> index =
            signedIndex.ReinterpretCast<uint32_t>();
        AscendC::LocalTensor<float> pairA = pairABuffer_.Get<float>();
        AscendC::LocalTensor<float> pairB = pairBBuffer_.Get<float>();

        AscendC::Sort32<float>(
            pairA,
            input,
            index,
            validRows * inner_ / VENDOR_SORT_UNIT);
        AscendC::PipeBarrier<PIPE_V>();

        if (k_ == LARGE_SORT_K) {
            BuildK32Pairs(pairA, pairB, validRows);
        } else {
            BuildK64Pairs(pairA, pairB, validRows);
        }

        AscendC::LocalTensor<float> out = outputQueue_.AllocTensor<float>();
        ExtractValues(out, pairA, validRows);

        AscendC::LocalTensor<float> tmp = tmpBuffer_.Get<float>();
        StableSoftplusSqrt(
            out,
            tmp,
            static_cast<uint32_t>(validRows * k_));

        inputQueue_.FreeTensor(staging);
        outputQueue_.EnQue(out);
        out = outputQueue_.DeQue<float>();

        const uint32_t packedOutputBytes = static_cast<uint32_t>(
            static_cast<uint64_t>(validRows) * static_cast<uint64_t>(k_) * sizeof(float));
        AscendC::DataCopyExtParams copyOutParams{
            1,
            packedOutputBytes,
            0,
            0,
            0};
        AscendC::DataCopyPad(
            outputGm_[static_cast<int64_t>(firstRow) * k_],
            out,
            copyOutParams);
        outputQueue_.FreeTensor(out);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> indexBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pairABuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pairBBuffer_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmpBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> patternBuffer_;
    AscendC::GlobalTensor<float> inputGm_;
    AscendC::GlobalTensor<float> outputGm_;

    int32_t rows_ = 0;
    int32_t experts_ = 0;
    int32_t inner_ = 0;
    int32_t k_ = 0;
    int32_t blockNum_ = 0;
    int32_t batchRows_ = 0;
    int32_t groupCount_ = 0;
    int32_t activeBlockNum_ = 0;
    int32_t copyAlignedElems_ = 0;
};

__global__ __vector__ void topk_fp32_vendor_large_probe_kernel(
    GM_ADDR routerLogits,
    GM_ADDR topkScores,
    int32_t rows,
    int32_t experts,
    int32_t inner,
    int32_t k,
    int32_t blockNum)
{
    AscendC::InitSocState();
    Fp32VendorLargeProbeKernel op;
    op.Init(routerLogits, topkScores, rows, experts, inner, k, blockNum);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 4093 - 2046;
        input[base + static_cast<size_t>(i)] =
            static_cast<float>(raw) / 64.0f +
            static_cast<float>(i % 29) * 0.0009765625f +
            static_cast<float>(row % 17) * 0.0078125f;
    }
    input[base] = 40.0f + static_cast<float>(row % 8);
    if (experts > 1) {
        input[base + 1] = -INFINITY;
    }
    if (experts > 2) {
        input[base + 2] = 23.5f + static_cast<float>(row % 4);
    }
}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    const int32_t inner = (experts + 31) / 32 * 32;
    const bool supported =
        (k == 32 && inner == 128) ||
        (k == 64 && inner == 1024);
    if (!supported) {
        std::fprintf(
            stderr,
            "unsupported fp32 large probe shape rows=%d E=%d inner=%d k=%d\n",
            rows,
            experts,
            inner,
            k);
        return false;
    }

    std::vector<float> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(float);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    const int32_t blockNum = rows < availableCoreNum ? rows : availableCoreNum;
    std::printf(
        "RUN fp32-large rows=%d E=%d inner=%d k=%d cores=%d\n",
        rows,
        experts,
        inner,
        k,
        blockNum);
    std::fflush(stdout);

    if (ok) {
        topk_fp32_vendor_large_probe_kernel<<<blockNum, nullptr, stream>>>(
            (GM_ADDR)inputDevice,
            (GM_ADDR)outputDevice,
            rows,
            experts,
            inner,
            k,
            blockNum);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    input[inputBase + static_cast<size_t>(i)];
            }
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float exact = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual =
                    output[outputBase + static_cast<size_t>(i)];
                const float tolerance =
                    2.0e-5f * std::fmax(1.0f, std::fabs(exact));
                if (!(std::isnan(exact) ? std::isnan(actual)
                      : std::fabs(actual - exact) <= tolerance)) {
                    std::fprintf(
                        stderr,
                        "[MISMATCH] rows=%d E=%d k=%d row=%d i=%d actual=%.9g exact=%.9g rawTop=%.9g\n",
                        rows,
                        experts,
                        k,
                        row,
                        i,
                        actual,
                        exact,
                        sorted[static_cast<size_t>(i)]);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    struct TestCase {
        int32_t rows;
        int32_t experts;
        int32_t k;
        int32_t cores;
    };
    const TestCase cases[] = {
        {1, 97, 32, 1},
        {17, 97, 32, 8},
        {33, 128, 32, 8},
        {1, 1024, 64, 1},
        {9, 1024, 64, 8},
        {17, 1024, 64, 8},
    };

    int32_t passed = 0;
    if (ok) {
        for (const auto& test : cases) {
            ok = RunOne(stream, test.rows, test.experts, test.k, test.cores);
            if (!ok) {
                break;
            }
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d fp32 large-k merge32/64 cases\n", passed);
    }
    return ok ? 0 : 1;
}
