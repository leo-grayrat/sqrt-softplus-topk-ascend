#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace {

constexpr int32_t ELEMENTS = 64;
constexpr uint32_t DATA_BYTES = ELEMENTS * sizeof(float);
constexpr uint32_t CMP_MASK_BYTES = 128;
constexpr uint32_t META_BYTES = 32;
constexpr float PIVOT = 0.5f;

class PivotMaskProbeKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR input,
        GM_ADDR output,
        GM_ADDR meta)
    {
        inputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(input));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output));
        metaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(meta));

        pipe_.InitBuffer(inputQueue_, 1, DATA_BYTES);
        pipe_.InitBuffer(outputQueue_, 1, DATA_BYTES);
        pipe_.InitBuffer(pivotBuffer_, DATA_BYTES);
        pipe_.InitBuffer(maskBuffer_, CMP_MASK_BYTES);
        pipe_.InitBuffer(metaBuffer_, META_BYTES);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> inputLocal = inputQueue_.AllocTensor<float>();
        AscendC::DataCopy(inputLocal, inputGm_, ELEMENTS);
        inputQueue_.EnQue(inputLocal);
        inputLocal = inputQueue_.DeQue<float>();

        AscendC::LocalTensor<float> pivotLocal = pivotBuffer_.Get<float>();
        AscendC::Duplicate(pivotLocal, PIVOT, ELEMENTS);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Compare(
            inputLocal,
            pivotLocal,
            AscendC::CMPMODE::GT,
            static_cast<uint64_t>(ELEMENTS),
            {1, 1, 1, 8, 8, 8});

        AscendC::LocalTensor<uint8_t> maskBytes = maskBuffer_.Get<uint8_t>();
        AscendC::GetCmpMask(maskBytes);
        AscendC::PipeBarrier<PIPE_V>();

        // FP32 一次 compare 恰好 64 elements。官方 Compare 文档规定结果按小端
        // bit 顺序对应输入索引；因此前 64 bits 应可作为一个 uint64_t 直接 popcount。
        AscendC::LocalTensor<uint64_t> maskWords64 =
            maskBytes.ReinterpretCast<uint64_t>();
        const uint64_t selectedBits = maskWords64.GetValue(0);
        const int64_t popcount = AscendC::GetBitCount<1>(selectedBits);

        // GatherMask 的 FP32 自定义 pattern 类型为 uint32_t。这里故意不做任何
        // bit 重排，直接复用 GetCmpMask 的同一物理 buffer；probe 就是验证这种
        // 零转换复用在 dav-2201 / CANN 9.0 上是否成立。
        AscendC::LocalTensor<uint32_t> gatherPattern =
            maskBytes.ReinterpretCast<uint32_t>();
        AscendC::LocalTensor<float> outputLocal = outputQueue_.AllocTensor<float>();
        uint64_t retained = 0;
        AscendC::GatherMask(
            outputLocal,
            inputLocal,
            gatherPattern,
            false,
            0,
            {1, 1, 0, 0},
            retained);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<float> metaLocal = metaBuffer_.Get<float>();
        metaLocal.SetValue(0, static_cast<float>(popcount));
        metaLocal.SetValue(1, static_cast<float>(retained));
        metaLocal.SetValue(2, static_cast<float>(selectedBits & 0xffffffffULL));
        metaLocal.SetValue(3, static_cast<float>((selectedBits >> 32) & 0xffffffffULL));

        AscendC::DataCopy(outputGm_, outputLocal, ELEMENTS);
        AscendC::DataCopy(metaGm_, metaLocal, META_BYTES / sizeof(float));

        inputQueue_.FreeTensor(inputLocal);
        outputQueue_.FreeTensor(outputLocal);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pivotBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> maskBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> metaBuffer_;
    AscendC::GlobalTensor<float> inputGm_;
    AscendC::GlobalTensor<float> outputGm_;
    AscendC::GlobalTensor<float> metaGm_;
};

__global__ __vector__ void pivot_mask_probe_kernel(
    GM_ADDR input,
    GM_ADDR output,
    GM_ADDR meta)
{
    AscendC::InitSocState();
    PivotMaskProbeKernel op;
    op.Init(input, output, meta);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

std::vector<float> BuildInput()
{
    std::vector<float> input(ELEMENTS);
    for (int32_t i = 0; i < ELEMENTS; ++i) {
        // 刻意让正负、等于 pivot 的位置交错，避免只验证连续 mask。
        const int32_t raw = (i * 29 + 7) % 41 - 20;
        input[static_cast<size_t>(i)] = static_cast<float>(raw) * 0.125f;
    }
    input[3] = PIVOT;
    input[17] = PIVOT;
    input[31] = 9.0f;
    input[48] = -9.0f;
    input[63] = 3.0f;
    return input;
}

bool AlmostEqual(float a, float b)
{
    return std::fabs(a - b) <= 1.0e-6f;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }

    aclrtContext context = nullptr;
    aclrtStream stream = nullptr;
    bool ok = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    if (ok) {
        ok = CheckAcl("aclrtCreateContext", aclrtCreateContext(&context, 0));
    }
    if (ok) {
        ok = CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));
    }

    std::vector<float> input = BuildInput();
    std::vector<float> expected;
    uint64_t expectedBits = 0;
    for (int32_t i = 0; i < ELEMENTS; ++i) {
        if (input[static_cast<size_t>(i)] > PIVOT) {
            expected.push_back(input[static_cast<size_t>(i)]);
            expectedBits |= (1ULL << i);
        }
    }

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    uint8_t* metaDevice = nullptr;
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(input)",
            aclrtMalloc(reinterpret_cast<void**>(&inputDevice), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(meta)",
            aclrtMalloc(reinterpret_cast<void**>(&metaDevice), META_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(input H2D)",
            aclrtMemcpy(inputDevice, DATA_BYTES, input.data(), DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    if (ok) {
#ifdef ASCENDC_CPU_DEBUG
        ICPU_RUN_KF(
            pivot_mask_probe_kernel,
            1,
            inputDevice,
            outputDevice,
            metaDevice);
#else
        pivot_mask_probe_kernel<<<1, nullptr, stream>>>(inputDevice, outputDevice, metaDevice);
#endif
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> actual(ELEMENTS, 0.0f);
    std::vector<float> meta(META_BYTES / sizeof(float), 0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(output D2H)",
            aclrtMemcpy(actual.data(), DATA_BYTES, outputDevice, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(meta D2H)",
            aclrtMemcpy(meta.data(), META_BYTES, metaDevice, META_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        const int32_t popcount = static_cast<int32_t>(meta[0]);
        const int32_t retained = static_cast<int32_t>(meta[1]);
        std::printf(
            "pivot=%g expected=%zu popcount=%d retained=%d\n",
            static_cast<double>(PIVOT),
            expected.size(),
            popcount,
            retained);

        if (popcount != static_cast<int32_t>(expected.size())) {
            std::fprintf(stderr, "[FAIL] GetBitCount mismatch\n");
            ok = false;
        }
        if (retained != static_cast<int32_t>(expected.size())) {
            std::fprintf(stderr, "[FAIL] GatherMask retained count mismatch\n");
            ok = false;
        }
        for (size_t i = 0; ok && i < expected.size(); ++i) {
            if (!AlmostEqual(actual[i], expected[i])) {
                std::fprintf(
                    stderr,
                    "[FAIL] candidate[%zu] actual=%g expected=%g\n",
                    i,
                    static_cast<double>(actual[i]),
                    static_cast<double>(expected[i]));
                ok = false;
            }
        }
    }

    if (inputDevice != nullptr) {
        aclrtFree(inputDevice);
    }
    if (outputDevice != nullptr) {
        aclrtFree(outputDevice);
    }
    if (metaDevice != nullptr) {
        aclrtFree(metaDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    if (context != nullptr) {
        aclrtDestroyContext(context);
    }
    aclrtResetDevice(0);
    aclFinalize();

    if (!ok) {
        return 1;
    }
    std::puts("PASS: pivot mask probe");
    return 0;
}
