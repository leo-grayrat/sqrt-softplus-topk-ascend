#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

// 直接包含当前参赛 kernel，避免调试器与真实实现漂移。
#include "../../submission/kernel.asc"

namespace {

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

bool BuildTopKTilingForProbe(
    int32_t inner,
    int32_t outter,
    int32_t k,
    uint32_t dtypeSize,
    AscendC::TopKMode mode,
    AscendC::tiling::TopkTiling& topkTiling,
    uint32_t& topkTmpBytes)
{
    platform_ascendc::PlatformAscendC* platform = nullptr;
#if defined(ASCENDC_CPU_DEBUG) && (__NPU_ARCH__ == 2201)
    // CANN 9.0 官方 TopK CPU-debug 样例要求 dav-2201 显式指定 Ascend910B1。
    platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1");
#else
    platform = platform_ascendc::PlatformAscendCManager::GetInstance();
#endif
    if (platform == nullptr) {
        std::fprintf(stderr, "[PLATFORM ERROR] PlatformAscendC is null\n");
        return false;
    }

    constexpr bool isReuseSource = false;
    constexpr bool isInitIndex = false;
    constexpr bool isLargest = true;

    if (!AscendC::TopKTilingFunc(
            *platform,
            inner,
            outter,
            k,
            dtypeSize,
            isInitIndex,
            mode,
            isLargest,
            topkTiling)) {
        return false;
    }

    uint32_t maxTmpBytes = 0;
    uint32_t minTmpBytes = 0;
    if (!AscendC::GetTopKMaxMinTmpSize(
            *platform,
            inner,
            outter,
            isReuseSource,
            isInitIndex,
            mode,
            isLargest,
            dtypeSize,
            maxTmpBytes,
            minTmpBytes)) {
        return false;
    }

    topkTmpBytes = (minTmpBytes + 31u) / 32u * 32u;
    return true;
}

float ReferenceTransform(float x)
{
    const float softplus = x > 20.0f ? x : std::log1p(std::exp(x));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
        input[base + static_cast<size_t>(i)] =
            static_cast<float>(raw) / 8.0f +
            static_cast<float>(i) * 1.0e-6f +
            static_cast<float>(row) * 1.0e-4f;
    }

    // 每一行都覆盖 stable-softplus 大值分支和 -inf 边界，同时让两行数据不同。
    input[base] = 25.0f + static_cast<float>(row) * 0.25f;
    if (experts > 1) {
        input[base + 1] = -INFINITY;
    }
}

bool RunOne(
    aclrtStream stream,
    int32_t experts,
    int32_t k,
    int32_t batchRows)
{
    const int32_t inner = (experts + 31) / 32 * 32;
    const int32_t chunkCount = inner / 32;
    const int32_t candidateCount = chunkCount * k;
    const int32_t candidateInner = (candidateCount + 31) / 32 * 32;

    AscendC::tiling::TopkTiling smallTopkTiling;
    AscendC::tiling::TopkTiling finalTopkTiling;
    uint32_t smallTmpBytes = 0;
    uint32_t finalTmpBytes = 0;

    if (!BuildTopKTilingForProbe(
            32,
            chunkCount,
            k,
            sizeof(float),
            AscendC::TopKMode::TOPK_NSMALL,
            smallTopkTiling,
            smallTmpBytes)) {
        std::fprintf(
            stderr,
            "[TILING ERROR] NSMALL E=%d k=%d batch=%d\n",
            experts,
            k,
            batchRows);
        return false;
    }
    if (!BuildTopKTilingForProbe(
            candidateInner,
            batchRows,
            k,
            sizeof(float),
            AscendC::TopKMode::TOPK_NORMAL,
            finalTopkTiling,
            finalTmpBytes)) {
        std::fprintf(
            stderr,
            "[TILING ERROR] NORMAL E=%d k=%d batch=%d candidateInner=%d\n",
            experts,
            k,
            batchRows,
            candidateInner);
        return false;
    }

    const uint32_t topkTmpBytes = smallTmpBytes > finalTmpBytes ? smallTmpBytes : finalTmpBytes;
    std::printf(
        "RUN E=%d k=%d batch=%d inner=%d chunks=%d candidates=%d/%d tmp=%u\n",
        experts,
        k,
        batchRows,
        inner,
        chunkCount,
        candidateCount,
        candidateInner,
        topkTmpBytes);
    std::fflush(stdout);

    std::vector<float> input(
        static_cast<size_t>(batchRows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < batchRows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes =
        static_cast<size_t>(batchRows) * static_cast<size_t>(experts) * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(batchRows) * static_cast<size_t>(k) * sizeof(float);
    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    if (ok) {
        sqrt_softplus_hierarchical_top_k_custom<float><<<1, nullptr, stream>>>(
            (GM_ADDR)inputDevice,
            (GM_ADDR)outputDevice,
            batchRows,
            experts,
            inner,
            k,
            1,
            batchRows,
            chunkCount,
            candidateCount,
            candidateInner,
            topkTmpBytes,
            smallTopkTiling,
            finalTopkTiling);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(batchRows) * static_cast<size_t>(k),
        0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < batchRows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(
                input.begin() + static_cast<std::ptrdiff_t>(inputBase),
                input.begin() + static_cast<std::ptrdiff_t>(inputBase + static_cast<size_t>(experts)));
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float expected = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual = output[outputBase + static_cast<size_t>(i)];
                const float tolerance = 1.0e-4f + 1.0e-4f * std::fabs(expected);
                if (!(std::fabs(actual - expected) <= tolerance)) {
                    std::fprintf(
                        stderr,
                        "[MISMATCH] E=%d k=%d batch=%d row=%d i=%d actual=%g expected=%g\n",
                        experts,
                        k,
                        batchRows,
                        row,
                        i,
                        actual,
                        expected);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

bool RunRange(
    aclrtStream stream,
    const std::vector<int32_t>& expertsValues,
    int32_t batchRows)
{
    int32_t count = 0;
    for (int32_t experts : expertsValues) {
        for (int32_t k = 2; k <= 16; ++k) {
            ++count;
            if (!RunOne(stream, experts, k, batchRows)) {
                std::fprintf(
                    stderr,
                    "FAILED after %d cases (batch=%d)\n",
                    count,
                    batchRows);
                return false;
            }
        }
    }
    std::printf(
        "PASS: %d parameter combinations (batch=%d)\n",
        count,
        batchRows);
    return true;
}

std::vector<int32_t> FullExpertsValues()
{
    std::vector<int32_t> expertsValues;
    expertsValues.push_back(64);
    for (int32_t inner = 96; inner <= 1024; inner += 32) {
        expertsValues.push_back(inner - 1);
        expertsValues.push_back(inner);
    }
    return expertsValues;
}

const std::vector<int32_t>& QuickExpertsValues()
{
    static const std::vector<int32_t> values = {
        64, 65, 96, 127, 128, 129, 160, 192, 224, 256,
        257, 320, 384, 448, 512, 640, 768, 896, 1024};
    return values;
}

bool ValidateExactArgs(int32_t experts, int32_t k, int32_t batchRows)
{
    if (experts < 64 || experts > 1024 || k < 2 || k > 16 || k > experts ||
        (batchRows != 1 && batchRows != 2)) {
        std::fprintf(
            stderr,
            "参数范围: 64<=E<=1024, 2<=k<=16, batchRows=1|2\n");
        return false;
    }
    return true;
}

}  // namespace

int main(int argc, char** argv)
{
    if (argc < 1 || argc > 4) {
        std::fprintf(
            stderr,
            "用法: %s [--full | --batch2 | --full-batch2 | E k [batchRows]]\n",
            argv[0]);
        return 2;
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }

    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    if (ok && (argc == 3 || argc == 4)) {
        const int32_t experts = std::atoi(argv[1]);
        const int32_t k = std::atoi(argv[2]);
        const int32_t batchRows = argc == 4 ? std::atoi(argv[3]) : 1;
        if (!ValidateExactArgs(experts, k, batchRows)) {
            ok = false;
        } else {
            ok = RunOne(stream, experts, k, batchRows);
        }
    } else if (ok && argc == 2) {
        if (std::strcmp(argv[1], "--full") == 0) {
            ok = RunRange(stream, FullExpertsValues(), 1);
        } else if (std::strcmp(argv[1], "--batch2") == 0) {
            ok = RunRange(stream, QuickExpertsValues(), 2);
        } else if (std::strcmp(argv[1], "--full-batch2") == 0) {
            ok = RunRange(stream, FullExpertsValues(), 2);
        } else {
            std::fprintf(stderr, "未知参数: %s\n", argv[1]);
            ok = false;
        }
    } else if (ok) {
        ok = RunRange(stream, QuickExpertsValues(), 1);
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();
    return ok ? 0 : 1;
}
