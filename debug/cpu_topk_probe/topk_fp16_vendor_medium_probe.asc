#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"

namespace {

constexpr int32_t MEDIUM_KEEP_K = 16;
constexpr int32_t MEDIUM_FIRST_STAGE_COLS = 256;
constexpr int32_t MEDIUM_MERGED_GROUP_COLS = 64;
constexpr int32_t MEDIUM_FINAL_VALUES = 64;
constexpr int32_t MEDIUM_FINAL_PAIR_FLOATS = MEDIUM_FINAL_VALUES * 2;

class Fp16VendorMediumProbeKernel {
public:
    __aicore__ inline void Init(
        GM_ADDR routerLogits,
        GM_ADDR topkScores,
        int32_t rows,
        int32_t experts,
        int32_t inner,
        int32_t k,
        int32_t blockNum)
    {
        rows_ = rows;
        experts_ = experts;
        inner_ = inner;
        k_ = k;
        blockNum_ = blockNum;
        batchRows_ = SelectVendorBatchRows(rows_, blockNum_, inner_);
        groupCount_ = (rows_ + batchRows_ - 1) / batchRows_;
        activeBlockNum_ = groupCount_ < blockNum_ ? groupCount_ : blockNum_;

        const uint32_t rawBytes = static_cast<uint32_t>(experts_) * sizeof(half);
        const uint32_t copyAlignedBytes =
            (rawBytes + ALIGN_BYTES - 1u) / ALIGN_BYTES * ALIGN_BYTES;
        copyAlignedElems_ = static_cast<int32_t>(copyAlignedBytes / sizeof(half));

        inputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(routerLogits));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(topkScores));

        const uint32_t batchStageBytes =
            static_cast<uint32_t>(batchRows_ * copyAlignedElems_) * sizeof(half);
        const uint32_t batchInputBytes =
            static_cast<uint32_t>(batchRows_ * inner_) * sizeof(float);
        const int32_t pairCols =
            inner_ > 128 && inner_ < MEDIUM_FIRST_STAGE_COLS
                ? MEDIUM_FIRST_STAGE_COLS
                : inner_;
        const uint32_t batchPairBytes =
            static_cast<uint32_t>(batchRows_ * pairCols * 2) * sizeof(float);
        const uint32_t batchFloatOutputBytes =
            static_cast<uint32_t>(batchRows_ * MEDIUM_KEEP_K) * sizeof(float);
        const uint32_t rawHalfOutputBytes =
            static_cast<uint32_t>(batchRows_ * MEDIUM_KEEP_K) * sizeof(half);
        const uint32_t batchHalfOutputBytes =
            (rawHalfOutputBytes + ALIGN_BYTES - 1u) / ALIGN_BYTES * ALIGN_BYTES;

        pipe_.InitBuffer(inputQueue_, 2, batchStageBytes);
        pipe_.InitBuffer(floatInputBuffer_, batchInputBytes);
        pipe_.InitBuffer(indexBuffer_, batchInputBytes);
        pipe_.InitBuffer(pairABuffer_, batchPairBytes);
        pipe_.InitBuffer(pairBBuffer_, batchPairBytes);
        pipe_.InitBuffer(floatOutputBuffer_, batchFloatOutputBytes);
        pipe_.InitBuffer(floatTmpBuffer_, batchFloatOutputBytes);
        pipe_.InitBuffer(patternBuffer_, ALIGN_BYTES);
        pipe_.InitBuffer(outputQueue_, 1, batchHalfOutputBytes);
    }

    __aicore__ inline void Process()
    {
        const int32_t blockIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
        if (blockIdx >= activeBlockNum_) {
            return;
        }

        InitIndexBatch();
        InitValuePattern();

        int32_t group = blockIdx;
        CopyInGroup(group);
        while (group < groupCount_) {
            const int32_t nextGroup = group + activeBlockNum_;
            if (nextGroup < groupCount_) {
                CopyInGroup(nextGroup);
            }
            ComputeGroup(group);
            group = nextGroup;
        }
    }

private:
    __aicore__ inline int32_t GroupValidRows(int32_t group) const
    {
        const int32_t firstRow = group * batchRows_;
        int32_t validRows = rows_ - firstRow;
        if (validRows > batchRows_) {
            validRows = batchRows_;
        }
        return validRows;
    }

    __aicore__ inline void InitIndexBatch()
    {
        AscendC::LocalTensor<int32_t> index = indexBuffer_.Get<int32_t>();
        AscendC::Duplicate(
            index,
            static_cast<int32_t>(0),
            static_cast<uint32_t>(batchRows_ * inner_));
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void InitValuePattern()
    {
        using namespace AscendC;
        LocalTensor<uint32_t> pattern = patternBuffer_.Get<uint32_t>();
        pattern.SetValue(0, BuildVendorValueMask(k_));
        pattern.SetValue(1, 0u);
        auto eventID = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(eventID);
        WaitFlag<HardEvent::S_V>(eventID);
    }

    __aicore__ inline void CopyInGroup(int32_t group)
    {
        AscendC::LocalTensor<half> staging = inputQueue_.AllocTensor<half>();
        const int32_t firstRow = group * batchRows_;
        const int32_t validRows = GroupValidRows(group);
        const uint32_t rowBytes = static_cast<uint32_t>(experts_) * sizeof(half);
        const uint8_t rightPadding = static_cast<uint8_t>(copyAlignedElems_ - experts_);

        AscendC::DataCopyExtParams copyParams;
        copyParams.blockCount = static_cast<uint16_t>(validRows);
        copyParams.blockLen = rowBytes;
        copyParams.srcStride = 0;
        copyParams.dstStride = 0;
        copyParams.rsv = 0;
        AscendC::DataCopyPadExtParams<half> padParams{
            true, 0, rightPadding, static_cast<half>(-INFINITY)};

        AscendC::DataCopyPad(
            staging,
            inputGm_[static_cast<int64_t>(firstRow) * experts_],
            copyParams,
            padParams);
        inputQueue_.EnQue(staging);
    }

    __aicore__ inline void ConvertRows(
        const AscendC::LocalTensor<float>& floatInput,
        const AscendC::LocalTensor<half>& staging,
        int32_t validRows)
    {
        if (copyAlignedElems_ == inner_) {
            AscendC::Cast(
                floatInput,
                staging,
                AscendC::RoundMode::CAST_NONE,
                static_cast<uint32_t>(validRows * inner_));
            AscendC::PipeBarrier<PIPE_V>();
            return;
        }

        AscendC::Duplicate(
            floatInput,
            -INFINITY,
            static_cast<uint32_t>(validRows * inner_));
        AscendC::PipeBarrier<PIPE_V>();

        for (int32_t row = 0; row < validRows; ++row) {
            AscendC::Cast(
                floatInput[static_cast<uint32_t>(row * inner_)],
                staging[static_cast<uint32_t>(row * copyAlignedElems_)],
                AscendC::RoundMode::CAST_NONE,
                static_cast<uint32_t>(copyAlignedElems_));
        }
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void CopyTop16FromSort32(
        const AscendC::LocalTensor<float>& dst,
        int32_t dstRowCols,
        const AscendC::LocalTensor<float>& src,
        int32_t srcRowCols,
        int32_t rows)
    {
        AscendC::Duplicate(
            dst,
            -INFINITY,
            static_cast<uint32_t>(rows * dstRowCols * 2));
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::DataCopyParams params;
        params.blockCount = static_cast<uint16_t>(rows);
        params.blockLen = 4;
        params.srcStride =
            static_cast<uint16_t>((srcRowCols - MEDIUM_KEEP_K) * 2 / 8);
        params.dstStride =
            static_cast<uint16_t>((dstRowCols - MEDIUM_KEEP_K) * 2 / 8);

        const int32_t chunkCount = inner_ / VENDOR_SORT_UNIT;
        for (int32_t chunk = 0; chunk < chunkCount; ++chunk) {
            AscendC::DataCopy(
                dst[static_cast<uint32_t>(chunk * MEDIUM_KEEP_K * 2)],
                src[static_cast<uint32_t>(chunk * VENDOR_SORT_UNIT * 2)],
                params);
        }
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void CopyTop16FromMerged64(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t rows)
    {
        AscendC::Duplicate(
            dst,
            -INFINITY,
            static_cast<uint32_t>(rows * MEDIUM_FINAL_VALUES * 2));
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::DataCopyParams params;
        params.blockCount = static_cast<uint16_t>(rows);
        params.blockLen = 4;
        params.srcStride = static_cast<uint16_t>(
            (MEDIUM_FIRST_STAGE_COLS - MEDIUM_KEEP_K) * 2 / 8);
        params.dstStride = static_cast<uint16_t>(
            (MEDIUM_FINAL_VALUES - MEDIUM_KEEP_K) * 2 / 8);

        for (int32_t group = 0; group < 4; ++group) {
            AscendC::DataCopy(
                dst[static_cast<uint32_t>(group * MEDIUM_KEEP_K * 2)],
                src[static_cast<uint32_t>(group * MEDIUM_MERGED_GROUP_COLS * 2)],
                params);
        }
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void MergeFourTop16(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t repeatTimes)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = MEDIUM_KEEP_K;
        params.elementLengths[1] = MEDIUM_KEEP_K;
        params.elementLengths[2] = MEDIUM_KEEP_K;
        params.elementLengths[3] = MEDIUM_KEEP_K;
        params.ifExhaustedSuspension = false;
        params.validBit = 15;
        params.repeatTimes = static_cast<uint16_t>(repeatTimes);

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[MEDIUM_KEEP_K * 2];
        srcList.src3 = src[MEDIUM_KEEP_K * 4];
        srcList.src4 = src[MEDIUM_KEEP_K * 6];
        AscendC::MrgSort<float>(dst, srcList, params);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void BuildFinalPairs(
        const AscendC::LocalTensor<float>& pairA,
        const AscendC::LocalTensor<float>& pairB,
        int32_t rows)
    {
        if (inner_ > 128) {
            CopyTop16FromSort32(
                pairB,
                MEDIUM_FIRST_STAGE_COLS,
                pairA,
                inner_,
                rows);
            MergeFourTop16(pairA, pairB, rows * 4);
            CopyTop16FromMerged64(pairB, pairA, rows);
        } else {
            CopyTop16FromSort32(
                pairB,
                MEDIUM_FINAL_VALUES,
                pairA,
                inner_,
                rows);
        }
        MergeFourTop16(pairA, pairB, rows);
    }

    __aicore__ inline void ExtractKValues(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src,
        int32_t rows)
    {
        using namespace AscendC;
        LocalTensor<uint32_t> pattern = patternBuffer_.Get<uint32_t>();
        GatherMaskParams params;
        uint64_t rsvdCnt = 0;
        params.src0BlockStride = 1;
        params.repeatTimes = static_cast<uint8_t>(rows);
        params.src0RepeatStride =
            static_cast<uint8_t>(MEDIUM_FINAL_PAIR_FLOATS / 8);
        params.src1RepeatStride = 0;
        GatherMask(
            dst.ReinterpretCast<int32_t>(),
            src.ReinterpretCast<int32_t>(),
            pattern,
            true,
            VENDOR_GATHER_REPEAT,
            params,
            rsvdCnt);
        PipeBarrier<PIPE_V>();
    }

    __aicore__ inline void ComputeGroup(int32_t group)
    {
        const int32_t firstRow = group * batchRows_;
        const int32_t validRows = GroupValidRows(group);

        AscendC::LocalTensor<half> staging = inputQueue_.DeQue<half>();
        AscendC::LocalTensor<float> floatInput = floatInputBuffer_.Get<float>();
        ConvertRows(floatInput, staging, validRows);

        AscendC::LocalTensor<int32_t> signedIndex = indexBuffer_.Get<int32_t>();
        AscendC::LocalTensor<uint32_t> index =
            signedIndex.ReinterpretCast<uint32_t>();
        AscendC::LocalTensor<float> pairA = pairABuffer_.Get<float>();
        AscendC::LocalTensor<float> pairB = pairBBuffer_.Get<float>();

        AscendC::Sort32<float>(
            pairA,
            floatInput,
            index,
            validRows * inner_ / VENDOR_SORT_UNIT);
        AscendC::PipeBarrier<PIPE_V>();

        BuildFinalPairs(pairA, pairB, validRows);

        AscendC::LocalTensor<float> floatOut = floatOutputBuffer_.Get<float>();
        ExtractKValues(floatOut, pairA, validRows);

        AscendC::LocalTensor<float> tmp = floatTmpBuffer_.Get<float>();
        StableSoftplusSqrt(
            floatOut,
            tmp,
            static_cast<uint32_t>(validRows * k_));

        AscendC::LocalTensor<half> halfOut = outputQueue_.AllocTensor<half>();
        AscendC::Cast(
            halfOut,
            floatOut,
            AscendC::RoundMode::CAST_RINT,
            static_cast<uint32_t>(validRows * k_));
        AscendC::PipeBarrier<PIPE_V>();

        inputQueue_.FreeTensor(staging);
        outputQueue_.EnQue(halfOut);
        halfOut = outputQueue_.DeQue<half>();

        const uint32_t packedOutputBytes = static_cast<uint32_t>(
            static_cast<uint64_t>(validRows) * static_cast<uint64_t>(k_) * sizeof(half));
        AscendC::DataCopyExtParams copyOutParams{
            1,
            packedOutputBytes,
            0,
            0,
            0};
        AscendC::DataCopyPad(
            outputGm_[static_cast<int64_t>(firstRow) * k_],
            halfOut,
            copyOutParams);
        outputQueue_.FreeTensor(halfOut);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatInputBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> indexBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pairABuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pairBBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatOutputBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatTmpBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> patternBuffer_;
    AscendC::GlobalTensor<half> inputGm_;
    AscendC::GlobalTensor<half> outputGm_;

    int32_t rows_ = 0;
    int32_t experts_ = 0;
    int32_t inner_ = 0;
    int32_t k_ = 0;
    int32_t blockNum_ = 0;
    int32_t batchRows_ = 0;
    int32_t groupCount_ = 0;
    int32_t activeBlockNum_ = 0;
    int32_t copyAlignedElems_ = 0;
};

__global__ __vector__ void topk_fp16_vendor_medium_probe_kernel(
    GM_ADDR routerLogits,
    GM_ADDR topkScores,
    int32_t rows,
    int32_t experts,
    int32_t inner,
    int32_t k,
    int32_t blockNum)
{
    AscendC::InitSocState();
    Fp16VendorMediumProbeKernel op;
    op.Init(routerLogits, topkScores, rows, experts, inner, k, blockNum);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

float HalfUlp(float value)
{
    value = std::fabs(value);
    if (value == 0.0f || value < std::ldexp(1.0f, -14)) {
        return std::ldexp(1.0f, -24);
    }
    int exponent = 0;
    (void)std::frexp(value, &exponent);
    return std::ldexp(1.0f, exponent - 11);
}

bool CloseToHalfRoundedReference(float actual, float exact)
{
    if (std::isinf(exact)) {
        return std::isinf(actual) && std::signbit(actual) == std::signbit(exact);
    }
    if (std::isnan(exact)) {
        return std::isnan(actual);
    }
    const float tolerance = 0.5f * HalfUlp(exact) + 2.0e-6f;
    return std::fabs(actual - exact) <= tolerance;
}

void FillInputRow(
    std::vector<half>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
        const float value =
            static_cast<float>(raw) / 8.0f +
            static_cast<float>(i % 17) * 0.00390625f +
            static_cast<float>(row % 11) * 0.015625f;
        input[base + static_cast<size_t>(i)] = static_cast<half>(value);
    }
    input[base] = static_cast<half>(25.0f + static_cast<float>(row % 8));
    if (experts > 1) {
        input[base + 1] = static_cast<half>(-INFINITY);
    }
    if (experts > 2) {
        input[base + 2] = static_cast<half>(12.5f + static_cast<float>(row % 4));
    }
}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    const int32_t inner = (experts + 31) / 32 * 32;
    if (k < 9 || k > MEDIUM_KEEP_K || inner > 512) {
        std::fprintf(stderr, "unsupported medium probe shape\n");
        return false;
    }

    std::vector<half> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(half);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(half);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    const int32_t blockNum = rows < availableCoreNum ? rows : availableCoreNum;
    std::printf(
        "RUN fp16-medium rows=%d E=%d inner=%d k=%d cores=%d\n",
        rows,
        experts,
        inner,
        k,
        blockNum);
    std::fflush(stdout);

    if (ok) {
        topk_fp16_vendor_medium_probe_kernel<<<blockNum, nullptr, stream>>>(
            (GM_ADDR)inputDevice,
            (GM_ADDR)outputDevice,
            rows,
            experts,
            inner,
            k,
            blockNum);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<half> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    static_cast<float>(input[inputBase + static_cast<size_t>(i)]);
            }
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float exact = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual =
                    static_cast<float>(output[outputBase + static_cast<size_t>(i)]);
                if (!CloseToHalfRoundedReference(actual, exact)) {
                    std::fprintf(
                        stderr,
                        "[MISMATCH] rows=%d E=%d k=%d row=%d i=%d actual=%g exact=%.9g rawTop=%g\n",
                        rows,
                        experts,
                        k,
                        row,
                        i,
                        actual,
                        exact,
                        sorted[static_cast<size_t>(i)]);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    struct TestCase {
        int32_t rows;
        int32_t experts;
        int32_t k;
        int32_t cores;
    };
    const TestCase cases[] = {
        {1, 128, 16, 1},
        {17, 128, 16, 8},
        {17, 200, 16, 8},
        {17, 224, 9, 8},
        {17, 257, 12, 8},
        {17, 497, 15, 8},
        {17, 512, 10, 8},
    };

    int32_t passed = 0;
    if (ok) {
        for (const auto& test : cases) {
            ok = RunOne(stream, test.rows, test.experts, test.k, test.cores);
            if (!ok) {
                break;
            }
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d fp16 keep16 medium-k cases\n", passed);
    }
    return ok ? 0 : 1;
}
