#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

namespace {

constexpr int32_t CHUNK = 32;
constexpr int32_t KEEP_K = 8;
constexpr int32_t EXPERTS = 256;
constexpr int32_t CHUNKS = EXPERTS / CHUNK;
constexpr int32_t PAIR_FLOATS = 2;
constexpr int32_t PREFIX_FLOATS = KEEP_K * PAIR_FLOATS;
constexpr int32_t MERGED_GROUP_FLOATS = 4 * KEEP_K * PAIR_FLOATS;
constexpr int32_t FINAL_PAIR_FLOATS = 64;
constexpr int32_t GATHER_REPEAT = 64;
constexpr uint32_t ALIGN_BYTES = 32;

__aicore__ inline uint32_t BuildValueMask(int32_t k)
{
    uint32_t mask = 1u;
    for (int32_t i = 1; i < k; ++i) {
        mask = (mask << 2u) | 1u;
    }
    return mask;
}

class Fp16VendorProbeKernel {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output, int32_t k)
    {
        k_ = k;
        inputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(input));
        outputGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(output));

        pipe_.InitBuffer(inputQueue_, 1, EXPERTS * sizeof(half));
        pipe_.InitBuffer(floatInputBuffer_, EXPERTS * sizeof(float));
        pipe_.InitBuffer(indexBuffer_, EXPERTS * sizeof(int32_t));
        pipe_.InitBuffer(sortedBuffer_, EXPERTS * PAIR_FLOATS * sizeof(float));
        pipe_.InitBuffer(packedBuffer_, CHUNKS * PREFIX_FLOATS * sizeof(float));
        pipe_.InitBuffer(mergedBuffer_, 2 * MERGED_GROUP_FLOATS * sizeof(float));
        pipe_.InitBuffer(finalBuffer_, FINAL_PAIR_FLOATS * sizeof(float));
        pipe_.InitBuffer(extractedBuffer_, ALIGN_BYTES);
        pipe_.InitBuffer(patternBuffer_, ALIGN_BYTES);
        pipe_.InitBuffer(outputQueue_, 1, ALIGN_BYTES);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<half> halfInput = inputQueue_.AllocTensor<half>();
        AscendC::DataCopy(halfInput, inputGm_, static_cast<uint32_t>(EXPERTS));
        inputQueue_.EnQue(halfInput);
        halfInput = inputQueue_.DeQue<half>();

        AscendC::LocalTensor<float> floatInput = floatInputBuffer_.Get<float>();
        AscendC::Cast(floatInput, halfInput, AscendC::RoundMode::CAST_NONE, EXPERTS);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<int32_t> indices = indexBuffer_.Get<int32_t>();
        AscendC::Duplicate(indices, static_cast<int32_t>(0), EXPERTS);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<float> sorted = sortedBuffer_.Get<float>();
        AscendC::Sort32<float>(
            sorted,
            floatInput,
            indices.ReinterpretCast<uint32_t>(),
            CHUNKS);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<float> packed = packedBuffer_.Get<float>();
        for (int32_t chunk = 0; chunk < CHUNKS; ++chunk) {
            AscendC::DataCopy(
                packed[static_cast<uint32_t>(chunk * PREFIX_FLOATS)],
                sorted[static_cast<uint32_t>(chunk * CHUNK * PAIR_FLOATS)],
                static_cast<uint32_t>(PREFIX_FLOATS));
        }
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<float> merged = mergedBuffer_.Get<float>();
        MergeFourTop8(merged, packed);
        MergeFourTop8(
            merged[MERGED_GROUP_FLOATS],
            packed[4 * PREFIX_FLOATS]);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<float> finalPairs = finalBuffer_.Get<float>();
        AscendC::Duplicate(finalPairs, -INFINITY, static_cast<uint32_t>(FINAL_PAIR_FLOATS));
        AscendC::PipeBarrier<PIPE_V>();
        MergeTwoTop8(finalPairs, merged);
        AscendC::PipeBarrier<PIPE_V>();

        using namespace AscendC;
        LocalTensor<uint32_t> pattern = patternBuffer_.Get<uint32_t>();
        pattern.SetValue(0, BuildValueMask(k_));
        pattern.SetValue(1, 0u);
        auto eventID = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        SetFlag<HardEvent::S_V>(eventID);
        WaitFlag<HardEvent::S_V>(eventID);

        AscendC::LocalTensor<float> extracted = extractedBuffer_.Get<float>();
        AscendC::GatherMaskParams gatherParams;
        uint64_t rsvdCnt = 0;
        gatherParams.src0BlockStride = 1;
        gatherParams.repeatTimes = 1;
        gatherParams.src0RepeatStride = static_cast<uint8_t>(FINAL_PAIR_FLOATS / 8);
        gatherParams.src1RepeatStride = 0;
        AscendC::GatherMask(
            extracted.ReinterpretCast<int32_t>(),
            finalPairs.ReinterpretCast<int32_t>(),
            pattern,
            true,
            GATHER_REPEAT,
            gatherParams,
            rsvdCnt);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::LocalTensor<half> outputHalf = outputQueue_.AllocTensor<half>();
        AscendC::Cast(outputHalf, extracted, AscendC::RoundMode::CAST_NONE, k_);
        AscendC::PipeBarrier<PIPE_V>();

        inputQueue_.FreeTensor(halfInput);
        outputQueue_.EnQue(outputHalf);
        outputHalf = outputQueue_.DeQue<half>();

        const uint32_t outputBytes = static_cast<uint32_t>(k_) * sizeof(half);
        AscendC::DataCopyExtParams copyOutParams{1, outputBytes, 0, 0, 0};
        AscendC::DataCopyPad(outputGm_, outputHalf, copyOutParams);
        outputQueue_.FreeTensor(outputHalf);
    }

private:
    __aicore__ inline void MergeFourTop8(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = KEEP_K;
        params.elementLengths[1] = KEEP_K;
        params.elementLengths[2] = KEEP_K;
        params.elementLengths[3] = KEEP_K;
        params.ifExhaustedSuspension = false;
        params.validBit = 15;
        params.repeatTimes = 1;

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[PREFIX_FLOATS];
        srcList.src3 = src[PREFIX_FLOATS * 2];
        srcList.src4 = src[PREFIX_FLOATS * 3];
        AscendC::MrgSort<float>(dst, srcList, params);
    }

    __aicore__ inline void MergeTwoTop8(
        const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src)
    {
        AscendC::MrgSort4Info params;
        params.elementLengths[0] = KEEP_K;
        params.elementLengths[1] = KEEP_K;
        params.elementLengths[2] = 0;
        params.elementLengths[3] = 0;
        params.ifExhaustedSuspension = false;
        params.validBit = 3;
        params.repeatTimes = 1;

        AscendC::MrgSortSrcList<float> srcList;
        srcList.src1 = src[0];
        srcList.src2 = src[MERGED_GROUP_FLOATS];
        srcList.src3 = src[0];
        srcList.src4 = src[0];
        AscendC::MrgSort<float>(dst, srcList, params);
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatInputBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> indexBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sortedBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> packedBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> mergedBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> finalBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> extractedBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> patternBuffer_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    AscendC::GlobalTensor<half> inputGm_;
    AscendC::GlobalTensor<half> outputGm_;
    int32_t k_ = 0;
};

__global__ __vector__ void topk_fp16_vendor_probe_kernel(
    GM_ADDR input,
    GM_ADDR output,
    int32_t k)
{
    AscendC::InitSocState();
    Fp16VendorProbeKernel op;
    op.Init(input, output, k);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

void FillInput(std::vector<half>& scores, int32_t experts)
{
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw = (i * 37 + 11) % 257 - 128;
        scores[static_cast<size_t>(i)] = static_cast<half>(static_cast<float>(raw) * 0.25f);
    }
    scores[0] = static_cast<half>(40.0f);
    scores[1] = static_cast<half>(-INFINITY);
}

bool RunOne(aclrtStream stream, int32_t experts, int32_t k)
{
    if (experts != EXPERTS || k < 2 || k > KEEP_K) {
        std::fprintf(stderr, "probe 仅支持 E=256, 2<=k<=8\n");
        return false;
    }

    std::vector<half> input(static_cast<size_t>(experts));
    FillInput(input, experts);
    std::vector<float> expected(static_cast<size_t>(experts));
    for (int32_t i = 0; i < experts; ++i) {
        expected[static_cast<size_t>(i)] = static_cast<float>(input[static_cast<size_t>(i)]);
    }
    std::sort(expected.begin(), expected.end(), std::greater<float>());

    const size_t inputBytes = input.size() * sizeof(half);
    const size_t outputBytes = static_cast<size_t>(k) * sizeof(half);
    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;

    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(input H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    std::printf("RUN fp16-vendor E=%d k=%d\n", experts, k);
    std::fflush(stdout);
    if (ok) {
        topk_fp16_vendor_probe_kernel<<<1, nullptr, stream>>>(
            (GM_ADDR)inputDevice,
            (GM_ADDR)outputDevice,
            k);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<half> output(static_cast<size_t>(k));
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(output D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t i = 0; i < k; ++i) {
            const float actual = static_cast<float>(output[static_cast<size_t>(i)]);
            const float golden = expected[static_cast<size_t>(i)];
            if (std::fabs(actual - golden) > 1.0e-3f) {
                std::fprintf(
                    stderr,
                    "[MISMATCH] E=%d k=%d i=%d actual=%g expected=%g\n",
                    experts,
                    k,
                    i,
                    actual,
                    golden);
                ok = false;
                break;
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    if (ok) {
        ok = RunOne(stream, 256, 3);
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: fp16 vendor half->FP32 selection probe\n");
    }
    return ok ? 0 : 1;
}
