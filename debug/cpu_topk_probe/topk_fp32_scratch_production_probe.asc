#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "../../submission/kernel.asc"

namespace {

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus = std::fmax(x,0.0f)+std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<float>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
        input[base + static_cast<size_t>(i)] =
            static_cast<float>(raw) / 8.0f +
            static_cast<float>(i) * 1.0e-6f +
            static_cast<float>(row) * 1.0e-4f;
    }

    input[base] = 25.0f + static_cast<float>(row) * 0.25f;
    if (experts > 1) {
        input[base + 1] = -INFINITY;
    }
    if (experts > 2) {
        input[base + 2] = input[base];
    }
    if (row%4==1) std::fill(input.begin()+base,input.begin()+base+experts,-4.0f);
    if (row%4==2) for(int i=0;i<k;++i) input[base+experts-1-i]=40.0f+i;
    if (row%4==3) for(int i=0;i<k;++i) input[base+i]=60.0f+i;

    if (row % 8 == 4) {
        std::fill(input.begin()+base,input.begin()+base+experts,-INFINITY);
    } else if (row % 8 == 5) {
        std::fill(input.begin()+base,input.begin()+base+experts,-10000.0f);
        for (int32_t i=0;i<k;++i) input[base+(row*32+i)%experts]=10000.0f-i;
    } else if (row % 8 == 6) {
        for (int32_t i=0;i<experts;++i) input[base+i]=(i%32==0 ? 50.0f : -3.0f);
    }

}

bool RunOne(
    aclrtStream stream,
    int32_t rows,
    int32_t experts,
    int32_t k,
    int32_t availableCoreNum)
{
    std::vector<float> input(
        static_cast<size_t>(rows) * static_cast<size_t>(experts));
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(float);
    const size_t outputBytes =
        static_cast<size_t>(rows) * static_cast<size_t>(k) * sizeof(float);

    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    int64_t inputShape[] = {rows, experts};
    TensorInfo inputTensor[] = {{inputShape, 2, 0}};
    TensorGroupInfo inputInfo{inputTensor, 1};
    int64_t outputShape[] = {rows, k};
    TensorInfo outputTensor[] = {{outputShape, 2, 0}};
    TensorGroupInfo outputInfo{outputTensor, 1};

    std::printf(
        "RUN production-topk rows=%d E=%d k=%d cores=%d\n",
        rows,
        experts,
        k,
        availableCoreNum);
    std::fflush(stdout);

    if (ok) {
        run_kernel(
            (GM_ADDR)inputDevice,
            inputInfo,
            (GM_ADDR)outputDevice,
            outputInfo,
            availableCoreNum,
            stream,
            k);
        ok = CheckAcl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream));
    }

    std::vector<float> output(
        static_cast<size_t>(rows) * static_cast<size_t>(k),
        0.0f);
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(D2H)",
            aclrtMemcpy(output.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase =
                static_cast<size_t>(row) * static_cast<size_t>(experts);
            std::vector<float> sorted(
                input.begin() + static_cast<std::ptrdiff_t>(inputBase),
                input.begin() + static_cast<std::ptrdiff_t>(
                    inputBase + static_cast<size_t>(experts)));
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase =
                static_cast<size_t>(row) * static_cast<size_t>(k);
            for (int32_t i = 0; i < k; ++i) {
                const float expected = ReferenceTransform(sorted[static_cast<size_t>(i)]);
                const float actual = output[outputBase + static_cast<size_t>(i)];
                if (!(std::fabs(actual - expected) <= 2.0e-5f * std::fmax(1.0f,std::fabs(expected)))) {
                    std::fprintf(
                        stderr,
                        "[MISMATCH] rows=%d E=%d k=%d cores=%d row=%d i=%d actual=%g expected=%g\n",
                        rows,
                        experts,
                        k,
                        availableCoreNum,
                        row,
                        i,
                        actual,
                        expected);
                    ok = false;
                    break;
                }
            }
        }
    }

    if (outputDevice != nullptr) {
        (void)aclrtFree(outputDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main(int argc, char** argv)
{
    if (argc != 1 && argc != 4 && argc != 5) {
        std::fprintf(stderr, "用法: %s [rows E k [cores]]\n", argv[0]);
        return 2;
    }

    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    if (platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910B1") == nullptr) {
        std::fprintf(stderr, "platform initialization failed\n"); return 1;
    }
    int32_t passed = 0;
    if (ok && (argc == 4 || argc == 5)) {
        const int32_t rows = std::atoi(argv[1]);
        const int32_t experts = std::atoi(argv[2]);
        const int32_t k = std::atoi(argv[3]);
        const int32_t cores = argc == 5 ? std::atoi(argv[4]) : 1;
        if (rows <= 0 || experts < 64 || experts > 1024 || k < 2 || k > 64 ||
            k > experts || cores <= 0) {
            std::fprintf(stderr, "参数范围: rows>0, 64<=E<=1024, 2<=k<=64, cores>0\n");
            ok = false;
        } else {
            ok = RunOne(stream, rows, experts, k, cores);
            passed = ok ? 1 : 0;
        }
    } else if (ok) {
        struct Case { int32_t rows, experts, k, cores; };
        std::vector<Case> cases;
        for (int32_t rows : {1, 15, 16, 17, 31, 32, 33, 64, 128})
            cases.push_back({rows, 210, 8, 1});
        for (int32_t rows : {1, 3, 4, 5, 7, 8, 9, 16, 32})
            cases.push_back({rows, 888, 8, 1});
        for (int32_t e : {193, 216, 224, 865, 880, 896})
            cases.push_back({33, e, 8, 1});
        for (int32_t e : {210, 888})
            for (int32_t rows : {17, 65, 257}) cases.push_back({rows,e,8,8});
        // Unchanged neighboring gates, including the other FP32 small-k cases.
        for (int32_t e : {192, 225, 864, 897, 150, 160})
            cases.push_back({33,e,8,8});
        cases.push_back({33,210,7,8});
        cases.push_back({33,888,7,8});
        for (const auto& test : cases) {
            ok = RunOne(stream,test.rows,test.experts,test.k,test.cores);
            if (!ok) break;
            ++passed;
        }
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();

    if (ok) {
        std::printf("PASS: %d production TopK cases\n", passed);
    }
    return ok ? 0 : 1;
}
