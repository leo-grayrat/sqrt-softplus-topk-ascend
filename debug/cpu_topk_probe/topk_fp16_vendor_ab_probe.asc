#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <functional>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#define run_kernel run_kernel_base
#include "../../submission/kernel.asc"
#undef run_kernel
#include "../../submission/fp16_vendor_override.h"

namespace {

bool CheckAcl(const char* action, aclError ret)
{
    if (ret == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ACL ERROR] %s: %d\n", action, static_cast<int>(ret));
    return false;
}

float ReferenceTransform(float x)
{
    const float softplus =
        std::fmax(x, 0.0f) + std::log1p(std::exp(-std::fabs(x)));
    return std::sqrt(softplus);
}

void FillInputRow(
    std::vector<half>& input,
    int32_t row,
    int32_t experts,
    int32_t k)
{
    const size_t base = static_cast<size_t>(row) * static_cast<size_t>(experts);
    for (int32_t i = 0; i < experts; ++i) {
        const int32_t raw =
            (i * 37 + experts * 13 + k * 7 + row * 53) % 257 - 128;
        const float value =
            static_cast<float>(raw) / 8.0f +
            static_cast<float>(i % 17) * 0.00390625f +
            static_cast<float>(row % 11) * 0.015625f;
        input[base + static_cast<size_t>(i)] = static_cast<half>(value);
    }

    input[base] = static_cast<half>(25.0f + static_cast<float>(row % 8));
    if (experts > 1) {
        input[base + 1] = static_cast<half>(-INFINITY);
    }
    if (experts > 2) {
        input[base + 2] = static_cast<half>(12.5f + static_cast<float>(row % 4));
    }
}

bool RunAB(aclrtStream stream)
{
    constexpr int32_t rows = 64;
    constexpr int32_t experts = 256;
    constexpr int32_t k = 4;
    constexpr int32_t cores = 8;

    std::vector<half> input(static_cast<size_t>(rows) * experts);
    for (int32_t row = 0; row < rows; ++row) {
        FillInputRow(input, row, experts, k);
    }

    const size_t inputBytes = input.size() * sizeof(half);
    const size_t outputBytes = static_cast<size_t>(rows) * k * sizeof(half);

    uint8_t* inputDevice = nullptr;
    uint8_t* vendorDevice = nullptr;
    uint8_t* baseDevice = nullptr;
    bool ok = CheckAcl(
        "aclrtMalloc(input)",
        aclrtMalloc(reinterpret_cast<void**>(&inputDevice), inputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(vendor)",
            aclrtMalloc(reinterpret_cast<void**>(&vendorDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMalloc(base)",
            aclrtMalloc(reinterpret_cast<void**>(&baseDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    if (ok) {
        ok = CheckAcl(
            "aclrtMemcpy(H2D)",
            aclrtMemcpy(inputDevice, inputBytes, input.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    int64_t inputShape[] = {rows, experts};
    TensorInfo inputTensor[] = {{inputShape, 2, 1}};
    TensorGroupInfo inputInfo{inputTensor, 1};
    int64_t outputShape[] = {rows, k};
    TensorInfo outputTensor[] = {{outputShape, 2, 1}};
    TensorGroupInfo outputInfo{outputTensor, 1};

    if (ok) {
        std::printf("RUN vendor rows=%d E=%d k=%d cores=%d\n", rows, experts, k, cores);
        run_kernel(
            (GM_ADDR)inputDevice,
            inputInfo,
            (GM_ADDR)vendorDevice,
            outputInfo,
            cores,
            stream,
            k);
        ok = CheckAcl("sync vendor", aclrtSynchronizeStream(stream));
    }

    if (ok) {
        std::printf("RUN baseline rows=%d E=%d k=%d cores=%d\n", rows, experts, k, cores);
        run_kernel_base(
            (GM_ADDR)inputDevice,
            inputInfo,
            (GM_ADDR)baseDevice,
            outputInfo,
            cores,
            stream,
            k);
        ok = CheckAcl("sync baseline", aclrtSynchronizeStream(stream));
    }

    std::vector<half> vendor(static_cast<size_t>(rows) * k);
    std::vector<half> base(static_cast<size_t>(rows) * k);
    if (ok) {
        ok = CheckAcl(
            "copy vendor D2H",
            aclrtMemcpy(vendor.data(), outputBytes, vendorDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }
    if (ok) {
        ok = CheckAcl(
            "copy base D2H",
            aclrtMemcpy(base.data(), outputBytes, baseDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    }

    float maxVendorGoldenDelta = 0.0f;
    int32_t maxRow = -1;
    int32_t maxIndex = -1;
    if (ok) {
        for (int32_t row = 0; row < rows && ok; ++row) {
            const size_t inputBase = static_cast<size_t>(row) * experts;
            std::vector<float> sorted(static_cast<size_t>(experts));
            for (int32_t i = 0; i < experts; ++i) {
                sorted[static_cast<size_t>(i)] =
                    static_cast<float>(input[inputBase + static_cast<size_t>(i)]);
            }
            std::sort(sorted.begin(), sorted.end(), std::greater<float>());

            const size_t outputBase = static_cast<size_t>(row) * k;
            for (int32_t i = 0; i < k; ++i) {
                const float vendorValue =
                    static_cast<float>(vendor[outputBase + static_cast<size_t>(i)]);
                const float baseValue =
                    static_cast<float>(base[outputBase + static_cast<size_t>(i)]);
                if (vendorValue != baseValue) {
                    std::fprintf(
                        stderr,
                        "[A/B MISMATCH] row=%d i=%d vendor=%g baseline=%g rawTop=%g\n",
                        row,
                        i,
                        vendorValue,
                        baseValue,
                        sorted[static_cast<size_t>(i)]);
                    ok = false;
                    break;
                }

                const half expectedHalf = static_cast<half>(
                    ReferenceTransform(sorted[static_cast<size_t>(i)]));
                const float expected = static_cast<float>(expectedHalf);
                const float delta = std::fabs(vendorValue - expected);
                if (delta > maxVendorGoldenDelta) {
                    maxVendorGoldenDelta = delta;
                    maxRow = row;
                    maxIndex = i;
                }
            }
        }
    }

    if (ok) {
        std::printf(
            "PASS: vendor matches baseline exactly; max host-half delta=%g at row=%d i=%d\n",
            maxVendorGoldenDelta,
            maxRow,
            maxIndex);
        const int32_t row = 39;
        const int32_t i = 2;
        const size_t inputBase = static_cast<size_t>(row) * experts;
        std::vector<float> sorted(static_cast<size_t>(experts));
        for (int32_t col = 0; col < experts; ++col) {
            sorted[static_cast<size_t>(col)] =
                static_cast<float>(input[inputBase + static_cast<size_t>(col)]);
        }
        std::sort(sorted.begin(), sorted.end(), std::greater<float>());
        const float exact = ReferenceTransform(sorted[static_cast<size_t>(i)]);
        const float roundedHost = static_cast<float>(static_cast<half>(exact));
        const float vendorValue = static_cast<float>(vendor[static_cast<size_t>(row) * k + i]);
        std::printf(
            "DIAG row=39 i=2 rawTop=%g hostTransform=%.9g hostHalf=%g vendor=%g\n",
            sorted[static_cast<size_t>(i)],
            exact,
            roundedHost,
            vendorValue);
    }

    if (baseDevice != nullptr) {
        (void)aclrtFree(baseDevice);
    }
    if (vendorDevice != nullptr) {
        (void)aclrtFree(vendorDevice);
    }
    if (inputDevice != nullptr) {
        (void)aclrtFree(inputDevice);
    }
    return ok;
}

}  // namespace

int main()
{
    if (!CheckAcl("aclInit", aclInit(nullptr))) {
        return 1;
    }
    bool deviceSet = CheckAcl("aclrtSetDevice", aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    bool ok = deviceSet && CheckAcl("aclrtCreateStream", aclrtCreateStream(&stream));

    if (ok) {
        ok = RunAB(stream);
    }

    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    if (deviceSet) {
        (void)aclrtResetDevice(0);
    }
    (void)aclFinalize();
    return ok ? 0 : 1;
}
